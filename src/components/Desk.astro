---
// The 3D desk. Everything about it is opt-in:
//   * its JS lives in a separate chunk that is only fetched if the gate passes
//   * the gate rejects low-memory/low-core devices, Save-Data, reduced-motion
//     and anything without WebGL
//   * wide, it loads once the page is idle; narrow, only once scrolled near
// A device that fails the gate downloads zero bytes of three.js, and never
// sees the space the desk would have taken.
---

<div class="desk" data-desk aria-hidden="true"></div>

<script>
  const mount = document.querySelector<HTMLElement>("[data-desk]");

  /* Wide is a backdrop beside the copy, narrow is a band above it, and the
     two load differently — see `arm`. Read once: the decision is about what
     kind of device this is, and a window resized across the line after the
     scene has mounted just gets the other layout of the same scene. */
  const wide = window.matchMedia("(min-width: 900px)");

  const capable = () => {
    const nav = navigator as Navigator & {
      deviceMemory?: number;
      connection?: { saveData?: boolean };
    };
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
      return false;
    if (nav.connection?.saveData) return false;
    if ((nav.deviceMemory ?? 8) < 4) return false;
    if ((navigator.hardwareConcurrency ?? 8) < 4) return false;
    try {
      const gl = document
        .createElement("canvas")
        .getContext("webgl2", { failIfMajorPerformanceCaveat: true });
      if (!gl) return false;
      gl.getExtension("WEBGL_lose_context")?.loseContext();
    } catch {
      return false;
    }
    return true;
  };

  if (mount) {
    let started = false;
    let io: IntersectionObserver | undefined;
    const start = () => {
      if (started) return;
      started = true;
      io?.disconnect();
      /* Plain three, so there is no JSX here and no Fast Refresh preamble to
         install before it loads — which used to live in this file, and was
         the thing that broke whenever a build re-optimised the dev server's
         dependencies underneath it. */
      import("../scenes/desk.js")
        .then((m) => m.mount(mount))
        // Surfaced rather than swallowed.
        .catch((err) => console.error("[desk] scene failed to load", err));
    };

    // Two ways in, whichever comes first.
    //
    // Wide: once the page has finished loading and the main thread goes
    // idle, a capable device fetches the scene regardless of scroll position.
    // Waiting for the element to come near meant the download only *started*
    // when you got there, so the desk landed several seconds late. Nothing is
    // taken from the initial load — this begins after `load`, and the scene
    // keeps its render loop parked until it's actually on screen.
    //
    // Narrow: approach only, and from much further out. A phone is the
    // device with the least to spare — data, battery, a slow core to parse
    // 120kB of three on — and the contact block is several screens down, so
    // most visits never reach it. A screen and a half of warning is a few
    // seconds of scrolling, which is what the download needs on a decent
    // connection; on a poor one the desk eases in late rather than every
    // visitor paying for it up front.
    const arm = () => {
      if (wide.matches) {
        const idle =
          window.requestIdleCallback ??
          ((fn: () => void) => setTimeout(fn, 200));
        const queue = () => idle(start, { timeout: 3000 });
        if (document.readyState === "complete") queue();
        else addEventListener("load", queue, { once: true });
      }

      // And if you scroll straight there before the browser goes idle, don't
      // wait for it.
      io = new IntersectionObserver(
        (entries) => entries.some((e) => e.isIntersecting) && start(),
        { rootMargin: wide.matches ? "300px" : "150% 0px" },
      );
      io.observe(mount);
    };

    /* `is-armed` is what gives the desk its space on a narrow screen.
       ---
       There it is a band in the flow above the copy rather than a backdrop
       behind it, so it can't simply be laid out and left empty for a device
       that fails the gate — that would be a blank stripe of colour on exactly
       the phones least able to run it. The box only exists once the gate has
       passed. It is set here, as the module runs, which is long before anyone
       has scrolled to the contact block, so the space is there before the
       reader is. */
    const consider = () => {
      if (!capable()) return;
      mount.classList.add("is-armed");
      arm();
    };

    if (wide.matches) consider();
    else {
      /* A phone doesn't even run the gate until the reader is heading for the
         desk. The WebGL probe creates and discards a context, which on a slow
         core is real main-thread time, and it used to run on every visit
         shortly after load — exactly when the reader is starting to scroll —
         whether or not they ever got near the contact block. A screen and a
         half out — the same distance `arm` loads from, so the probe, the space
         and the download all happen together — is still far enough below the
         viewport that the space `is-armed` opens up is never seen arriving.
         Not further: on a phone the contact block starts under three and a
         half screens down, so anything much wider fires on load and buys
         nothing. Watched on the contact block,
         not the mount: the mount is display:none until armed, and an element
         with no box never intersects anything. */
      const near = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          near.disconnect();
          consider();
        },
        { rootMargin: "150% 0px" },
      );
      near.observe(mount.parentElement ?? mount);
    }
  }
</script>

<style>
  .desk {
    display: none;
  }

  /* Narrow: a band across the top of the contact block, with the copy under
     it. Bled out over the block's padding on three sides so the desk meets
     the edges the way it does on a wide screen; the contact block's own CSS
     stacks it (see .contact in index.astro). The scene's zoom follows the
     element's width, so at the same aspect as the wide panel's desk area it
     is the same framing, just smaller. */
  @media (max-width: 899.98px) {
    .desk.is-armed {
      display: block;
      position: relative;
      margin: calc(-1 * var(--desk-bleed, 0px)) calc(-1 * var(--desk-bleed, 0px)) 0;
      aspect-ratio: 16 / 10;
      opacity: 0;
      transition: opacity 0.7s var(--ease-settle);
    }

    .desk.is-ready {
      opacity: 1;
    }

    .desk :global(canvas) {
      image-rendering: pixelated;
      width: 100% !important;
      height: 100% !important;
      display: block;
    }
  }

  /* Bleeds to the top, right and bottom edges of the panel so the desk is
     never cropped, starting partway left so the copy overlaps it slightly.
     Absolutely positioned, so mounting it shifts no layout at all. */
  @media (min-width: 900px) {
    .desk {
      display: block;
      position: absolute;
      inset: 0 0 0 34%;
      /* No blend mode. The ASCII version was ink — characters printed into the
         block with `multiply`, which worked because the gaps between them
         carried none. The retro pass is a colour image with a hard alpha, so
         it sits on the block rather than printing into it; multiplying it just
         drove every channel toward the block's own colour and took the desk to
         black. */
      /* Held back until the scene reports its first real frame, so it eases
         in instead of popping. `is-ready` is set from the scene once the
         model and textures have resolved — not on canvas creation, which
         happens while the assets are still in flight. */
      opacity: 0;
      transition: opacity 0.7s var(--ease-settle);
    }

    .desk.is-ready {
      opacity: 1;
    }

    /* The canvas is what you see now, rather than a source the ASCII effect
       read back and hid. `pixelated` is belt and braces — the retro pass
       already magnifies its own low-resolution target through a
       NearestFilter — but it also covers the browser scaling the canvas
       between its drawing buffer and its CSS size. */
    .desk :global(canvas) {
      image-rendering: pixelated;
      width: 100% !important;
      height: 100% !important;
      display: block;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .desk {
      display: none;
    }
  }
</style>
