---
import { Picture } from "astro:assets";
import { render } from "astro:content";
import Prose from "./Prose.astro";
import YouTube from "./mdx/YouTube.astro";
import TikTok from "./mdx/TikTok.astro";
import Video from "./mdx/Video.astro";
import CodeDemo from "./mdx/CodeDemo.astro";
import { formatDate, tagSlug, tagLabel, type Post } from "../lib/posts";
import { bottomTint } from "../lib/tint";

interface Props {
  post: Post;
  colour: string;
  open?: boolean;
  loading?: "lazy" | "eager";
}
const { post, colour, open = false, loading = "lazy" } = Astro.props;
// `excerpt` is deliberately not pulled in here. It still earns its keep as the
// post's meta description and in the RSS feed, but the card shows only its
// eyebrow and title — the summary text made every row taller and competed with
// the headline it sat under.
const { title, date, type, image, links } = post.data;

// Slugged tags drive the CSS-only filter in PostGrid.
const tagTokens = type.map(tagSlug).join(" ");

// Only the open row renders its article. Every row used to render its whole
// post into every page, so each of the eleven blog URLs carried all ten of
// them: 91% of the HTML was posts you were not reading, it grew with every
// post written, and Google saw eleven documents with identical text and threw
// most of them away.
const { Content } = open ? await render(post) : { Content: null };

// So a closed row is a link to its own page, and the open one is the expanded
// article. Swapping the wrapper element rather than writing the card twice.
// As a link it still works with no JavaScript, and the router turns it into a
// client-side swap — with the card prefetched on hover, arriving at the post
// looks like the row expanding, which is what it used to be.
const Row = open ? "details" : "a";
const Head = open ? "summary" : "div";
const rowProps = open ? { open: true } : { href: `/blog/${post.id}` };

// Sampled from the image's lower band at build time.
const t = image ? await bottomTint(image) : null;
---

<Row class="row" id={post.id} data-tags={tagTokens} {...rowProps}>
  <Head
    class:list={["card", `block block--${colour}`]}
    style={t && `--tint:${t.tint};--on-tint:${t.ink}`}
  >
    {
      image && (
        <Picture
          class="card__img"
          pictureAttributes={{ class: "card__pic" }}
          src={image}
          alt=""
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[560, 900, 1200, 1800]}
          sizes="(max-width: 940px) calc(100vw - 32px), 888px"
          loading={loading}
          decoding="async"
        />
      )
    }
    <div class="card__text">
      <p class="eyebrow">
        {`${type.join(" · ")} · `}<time datetime={date.toISOString()}
          >{formatDate(date)}</time
        >
      </p>
      <h2>{title}</h2>
    </div>
  </Head>

  <!-- Sits below the card, directly on the page background — no panel. -->
  {Content && (
  <article class="body">
    <Prose>
      <Content components={{ YouTube, TikTok, Video, CodeDemo }} />
    </Prose>

    <footer class="body__foot">
      {
        links.map((l) => (
          <a
            class="pill pill--blog"
            href={l.url}
            rel="noopener noreferrer"
            target="_blank"
          >
            {/* Frontmatter writes these as "SITE"; tagLabel sentence-cases
                all-caps while leaving brands like GitHub alone. */}
            {tagLabel(l.title)} ↗
          </a>
        ))
      }
      <button
        class="pill pill--blog"
        type="button"
        data-share={`/blog/${post.id}`}
        data-title={title}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 15.5V3.5m0 0L8.25 7.25M12 3.5l3.75 3.75"></path>
          <path d="M5 13v5.75A1.75 1.75 0 0 0 6.75 20.5h10.5A1.75 1.75 0 0 0 19 18.75V13"
          ></path>
        </svg>
        Share
      </button>
    </footer>
  </article>
  )}
</Row>

<style>
  .row {
    scroll-margin-top: var(--nav-space);
  }

  /* A closed row is an anchor rather than a details, so it needs a block box
     and none of a link's own styling — the card inside is the whole control. */
  a.row {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* See Card.astro — the <picture> wrapper must not become a flex item. */
  .card__pic {
    display: contents;
  }

  /* See Card.astro — the block colour behind a photo is invisible except
     through the antialiased corner pixels, where it traces the curve as a
     bright outline. The sampled tint blends instead. */
  .card:has(.card__img) {
    background: var(--tint, transparent);
  }

  /* --- Card (always visible) --- */
  .card {
    position: relative;
    isolation: isolate;
    cursor: pointer;
    /* 240px on the original. */
    min-height: 240px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    list-style: none;
    transition: transform 0.18s ease;
  }

  .card::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-3px);
    }
  }

  /* 1px overshoot so the parent's clip makes the curve through solid image,
     not through the image's own antialiased edge — see Card.astro. */
  .card__img {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    /* See Card.astro — the global img max-width would cap the overshoot, and
       the radius grows with the box so no ghost outline forms on the curve. */
    max-width: none;
    object-fit: cover;
    border-radius: calc(var(--r-lg) + 1px);
    z-index: -2;
  }

  /* Overlay tinted with the image's own bottom colour, pushed light or dark
     so the text always contrasts. */
  .card:has(.card__img)::after {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: calc(var(--r-lg) + 1px);
    background: linear-gradient(
      to top,
      var(--tint) 0%,
      var(--tint) 30%,
      transparent 88%
    );
  }

  .card:has(.card__img) .card__text {
    color: var(--on-tint, #fff);
  }

  .card__text h2 {
    margin: 0.25em 0 0;
    font-size: var(--t-card-row);
  }

  /* --- Body (revealed, sitting on the page background) --- */
  .body {
    padding-block: var(--post-pad);
  }

  /* Same column as the prose, so the buttons line up with the article text. */
  .body__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 40px auto 0;
    max-width: var(--measure);
    width: 100%;
  }

  .body__foot svg {
    width: 1.05em;
    height: 1.05em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Opening a row used to animate its height over 0.45s. That is the post
     arriving — the thing you clicked for — so the animation was time spent
     waiting to read rather than an effect worth having. It opens immediately
     now. */

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
