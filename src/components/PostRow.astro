---
import { Picture } from "astro:assets";
import { render } from "astro:content";
import Prose from "./Prose.astro";
import YouTube from "./mdx/YouTube.astro";
import TikTok from "./mdx/TikTok.astro";
import Video from "./mdx/Video.astro";
import CodeDemo from "./mdx/CodeDemo.astro";
import { formatDate, tagSlug, tagLabel, type Post } from "../lib/posts";
import { paletteFor, type Palette } from "../lib/palette";

interface Props {
  post: Post;
  colour: Palette;
  open?: boolean;
  loading?: "lazy" | "eager";
}
const { post, colour, open = false, loading = "lazy" } = Astro.props;
const { title, date, excerpt, type, image, links } = post.data;

// Slugged tags drive the CSS-only filter in PostGrid.
const tagTokens = type.map(tagSlug).join(" ");

// The whole post is rendered here, at build time. Opening a row reveals HTML
// that is already on the page — no request, no import, no loading state.
const { Content } = await render(post);

// The ink comes from the post's own image where it has one, so the list reads
// as a set of printed plates rather than a rotation through a fixed palette.
const ink: Palette = image ? await paletteFor(image) : colour;
---

<details class="row" open={open} id={post.id} data-tags={tagTokens}>
  <summary
    class:list={[
      "card",
      `block block--${ink}`,
      // Registration marks only where the corners are free. Once the
      // photograph fills the card all four carry a plate, and a crosshair
      // behind one is a smudge under the type. Same rule as Card.astro.
      !image && "marks",
      !image && "card--bare",
    ]}
  >
    {
      image && (
        <Picture
          class="card__img duo"
          pictureAttributes={{ class: "card__pic" }}
          src={image}
          alt=""
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[560, 900, 1200, 1800]}
          sizes="(max-width: 940px) calc(100vw - 32px), 888px"
          loading={loading}
          decoding="async"
        />
      )
    }

    <p class="card__chip card__eyebrow">
      <span class="eyebrow">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {type.length > 0 ? ` · ${type.map(tagLabel).join(" · ")}` : ""}
      </span>
    </p>

    <p class="card__chip card__meta">
      <span>
        <span class="card__cue" aria-hidden="true"></span>/blog/{post.id}
      </span>
    </p>

    <h2 class="card__chip card__title plate"><span>{title}</span></h2>
  </summary>

  <!-- Sits below the card, directly on the page background — no panel. -->
  <article class="body">
    <Prose>
      <Content components={{ YouTube, TikTok, Video, CodeDemo }} />
    </Prose>

    <footer class="body__foot">
      {
        links.map((l) => (
          <a
            class="pill pill--blog out"
            href={l.url}
            rel="noopener noreferrer"
            target="_blank"
          >
            {/* Frontmatter writes these as "SITE"; tagLabel sentence-cases
                all-caps while leaving brands like GitHub alone. */}
            {tagLabel(l.title)}
          </a>
        ))
      }
      <button
        class="pill pill--blog"
        type="button"
        data-share={`/blog/${post.id}`}
        data-title={title}
      >
        Share
      </button>
    </footer>
  </article>
</details>

<style>
  .row {
    scroll-margin-top: var(--nav-space);
  }

  /* --- Card (always visible) --- */
  /* Same anatomy as Card.astro, and for the same reason: the photograph fills
     the card and the three pieces of text sit on plates over it — the date and
     tags top left, the path top right, the title bottom left. The one
     difference is that this one is a summary, so it opens the post below
     rather than going anywhere, and the top-right plate carries the +/−
     disclosure cue where a link card carries an arrow. */
  .card {
    position: relative;
    display: block;
    cursor: pointer;
    min-height: 240px;
    padding: 0;
    list-style: none;
  }

  .card--bare {
    padding: 20px;
  }

  .card.block--paper {
    box-shadow: inset 0 0 0 1px var(--rule-mid);
  }

  .card::-webkit-details-marker {
    display: none;
  }

  /* See Card.astro — the <picture> wrapper must not become a box of its own. */
  .card__pic {
    display: contents;
  }

  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .card__chip {
    position: absolute;
    z-index: 1;
    margin: 0;
    max-width: calc(100% - 24px);
  }

  /* One line each and always will be, so these take the plate on the block
     rather than on the inline — see "Caption plates" in global.css for why
     that matters. */
  .card__eyebrow,
  .card__meta {
    padding: 6px var(--plate-pad-x);
    line-height: 1;
    background: var(--block-ground);
  }

  .card--bare .card__eyebrow,
  .card--bare .card__meta,
  .card--bare .card__title > span {
    padding: 0;
    background: none;
  }

  .card__eyebrow {
    top: 0;
    left: 0;
  }

  .card__meta {
    top: 0;
    right: 0;
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card__title {
    /* Offset by the plate's overhang rather than sitting at 0 — see
       "Caption plates" in global.css. */
    bottom: var(--plate-overhang);
    left: 0;
    font-size: var(--t-card-row);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .card--bare .card__title {
    position: static;
    margin-top: 12px;
    line-height: 1.15;
  }

  /* Disclosure cue: + closed, − open. A glyph rather than a rotating chevron,
     and specifically these two — both are one character wide in a monospaced
     face, so the plate never changes width when the row opens. The minus is
     U+2212 rather than a hyphen so it sits at the same optical weight and
     height as the plus. */
  .card__cue::before {
    content: "+";
    font-weight: 700;
    margin-right: 0.5em;
  }

  .row[open] .card__cue::before {
    content: "\2212";
  }

  /* Same as the grid cards: hovering drops the photograph out of `multiply`
     and lets it print in its own colours. No easing — two states, not two ends
     of a range — and pointer devices only, because on a touch screen the
     hover lasts exactly as long as the tap that is already opening the row. */
  @media (hover: hover) {
    .card:hover .card__img {
      mix-blend-mode: normal;
      filter: none;
    }
  }

  /* --- Body (revealed, sitting on the page background) --- */
  .body {
    padding-block: var(--post-pad);
  }

  /* Same column as the prose, so the buttons line up with the article text. */
  .body__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 40px auto 0;
    max-width: var(--measure);
    width: 100%;
  }

  /* Animate open/close where supported. Elsewhere it simply snaps — no JS. */
  @supports (interpolate-size: allow-keywords) {
    .row::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.45s ease,
        content-visibility 0.45s allow-discrete;
    }

    .row[open]::details-content {
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row::details-content {
      transition: none;
    }
  }
</style>
