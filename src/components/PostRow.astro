---
import { Image, Picture } from "astro:assets";
import {
  ENABLED as DITHERED,
  FORMAT as DITHER_FORMAT,
  widths as ditherWidths,
} from "../lib/dither-images.mjs";
import { render } from "astro:content";
import Prose from "./Prose.astro";
import YouTube from "./mdx/YouTube.astro";
import TikTok from "./mdx/TikTok.astro";
import Video from "./mdx/Video.astro";
import CodeDemo from "./mdx/CodeDemo.astro";
import Img from "./mdx/Img.astro";
import { formatDate, tagSlug, tagLabel, type Post } from "../lib/posts";
import type { Palette } from "../lib/palette";

interface Props {
  post: Post;
  colour: Palette;
  open?: boolean;
  loading?: "lazy" | "eager";
}
const { post, colour, open = false, loading = "lazy" } = Astro.props;
const { title, date, excerpt, type, image, links } = post.data;
// The cover arrived dithered — see content.config.ts.
const predithered = post.data.dithered;

// Slugged tags drive the CSS-only filter in PostGrid.
const tagTokens = type.map(tagSlug).join(" ");

// The whole post is rendered here, at build time. Opening a row reveals HTML
// that is already on the page — no request, no import, no loading state.
const { Content } = await render(post);

// The ink is decided by the list, not by the row: it comes from the post's own
// photograph, but the choice has to see its neighbours to keep two of them off
// the same colour. See `paletteRun`, and PostGrid, which calls it.
const ink: Palette = colour;

// Handed down to the article body so its links and pull quotes are underlined
// in the same ink the card above them is printed on. A monochrome photograph
// prints on paper, which is the page's own ground and so no use as an
// underline — those fall back to the house yellow.
const proseInk = ink === "paper" ? "sun" : ink;
---

<details
  class="row"
  open={open}
  id={post.id}
  data-tags={tagTokens}
  style={`--prose-underline: var(--${proseInk})`}
>
  <summary
    class:list={[
      "card",
      `block block--${ink}`,
      // Registration marks only where the corners are free. Once the
      // photograph fills the card all four carry a plate, and a crosshair
      // behind one is a smudge under the type. Same rule as Card.astro.
      !image && "marks",
      !image && "card--bare",
    ]}
  >
    {/* See Card.astro — a dithered image is a PNG and only a PNG. */}
    {
      image &&
        (predithered ? (
          /* Already dithered when it arrived, so it is emitted as it is:
             no resize, no re-encode, no second grid over the first. It is
             smaller than any width this would have asked for anyway, and
             `is-dithered` has the browser scale it up without smoothing. */
          <img
            class="card__img duo is-dithered"
            src={image.src}
            width={image.width}
            height={image.height}
            alt=""
            loading={loading}
            decoding="async"
          />
        ) : DITHERED ? (
          <Image
            class="card__img duo is-dithered"
            src={image}
            alt=""
            format={DITHER_FORMAT}
            dither
            widths={ditherWidths([560, 900, 1200, 1800])}
            sizes="(max-width: 940px) calc(100vw - 32px), 888px"
            loading={loading}
            decoding="async"
          />
        ) : (
          <Picture
            class="card__img duo"
            pictureAttributes={{ class: "card__pic" }}
            src={image}
            alt=""
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[560, 900, 1200, 1800]}
            sizes="(max-width: 940px) calc(100vw - 32px), 888px"
            loading={loading}
            decoding="async"
          />
        ))
    }

    <div class="card__top">
      <p class="card__chip">
        <span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {type.length > 0 ? ` · ${type.map(tagLabel).join(" · ")}` : ""}
        </span>
      </p>

      {/* The path used to be printed here, as a link card prints its
          destination. It ran to forty characters on a long slug, which on a
          narrow card left nothing for the date beside it — and it was never
          the useful half: this card opens the post in place rather than going
          anywhere, so what it owes the reader is the state of the disclosure,
          not a URL they are not about to follow. */}
      <p class="card__chip card__meta">
        <span><span class="card__cue" aria-hidden="true"></span>Read</span>
      </p>
    </div>

    <h2 class="card__chip card__title plate"><span>{title}</span></h2>
  </summary>

  <!-- Sits below the card, directly on the page background — no panel. -->
  <article class="body">
    <Prose>
      <Content components={{ YouTube, TikTok, Video, CodeDemo, img: Img }} />
    </Prose>

    <footer class="body__foot">
      {
        links.map((l) => (
          <a
            class="pill pill--blog out"
            href={l.url}
            rel="noopener noreferrer"
            target="_blank"
          >
            {/* Frontmatter writes these as "SITE"; tagLabel sentence-cases
                all-caps while leaving brands like GitHub alone. */}
            {tagLabel(l.title)}
          </a>
        ))
      }
      <button
        class="pill pill--blog"
        type="button"
        data-share={`/blog/${post.id}`}
        data-title={title}
      >
        Share
      </button>
    </footer>
  </article>
</details>

<style>
  .row {
    scroll-margin-top: var(--nav-space);
  }

  /* --- Card (always visible) --- */
  /* Same anatomy as Card.astro, and for the same reason: the photograph fills
     the card and the three pieces of text sit on plates over it — the date and
     tags top left, the path top right, the title bottom left. The one
     difference is that this one is a summary, so it opens the post below
     rather than going anywhere, and the top-right plate carries the +/−
     disclosure cue where a link card carries an arrow. */
  .card {
    position: relative;
    display: block;
    cursor: pointer;
    min-height: 240px;
    padding: 0;
    list-style: none;
  }

  .card--bare {
    padding: 20px;
  }

  .card.block--paper {
    box-shadow: inset 0 0 0 1px var(--rule-mid);
  }

  .card::-webkit-details-marker {
    display: none;
  }

  /* See Card.astro — the <picture> wrapper must not become a box of its own. */
  .card__pic {
    display: contents;
  }

  /* Held back to 60% at rest, so the block's colour carries the card and the
     photograph reads as something printed into it rather than as the card
     itself. Full strength on hover, with the blend and the duotone filter
     dropped at the same instant — the image arrives all at once rather than
     brightening into place.

     On a touch screen there is no hover, so the card stays at 60% — which is
     the same bargain the duotone already makes there, and the reason the
     titles sit on plates rather than on the picture. */
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    opacity: 0.6;
  }

  .card__chip {
    margin: 0;
  }

  /* One row for both top plates, and the row owns the type so the two are the
     same height — see Card.astro, which carries the full note on why placing
     them separately made them differ. */
  .card__top {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  .card__top .card__chip {
    min-width: 0;
    padding: 6px var(--plate-pad-x);
    background: var(--block-ground);
  }

  .card__top .card__chip > span {
    font: inherit;
    letter-spacing: inherit;
    line-height: 1;
  }

  .card--bare .card__top,
  .card--bare .card__title {
    position: static;
    max-width: none;
  }

  .card--bare .card__top .card__chip,
  .card--bare .card__title > span {
    padding: 0;
    background: none;
  }

  .card__title {
    position: absolute;
    z-index: 1;
    max-width: calc(100% - 24px);
    /* Offset by the plate's overhang rather than sitting at 0 — see
       "Caption plates" in global.css. */
    bottom: var(--plate-overhang);
    left: 0;
    font-size: var(--t-card-row);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .card--bare .card__title {
    margin-top: 12px;
    line-height: 1.15;
  }

  /* Disclosure cue: + closed, − open. A glyph rather than a rotating chevron,
     and specifically these two — both are one character wide in a monospaced
     face, so the plate never changes width when the row opens. The minus is
     U+2212 rather than a hyphen so it sits at the same optical weight and
     height as the plus. */
  .card__cue::before {
    content: "+";
    font-weight: 700;
    margin-right: 0.5em;
  }

  .row[open] .card__cue::before {
    content: "\2212";
  }

  /* Same as the grid cards: hovering drops the photograph out of `multiply`
     and lets it print in its own colours. No easing — two states, not two ends
     of a range — and pointer devices only, because on a touch screen the
     hover lasts exactly as long as the tap that is already opening the row. */
  @media (any-hover: hover) {
    .card:hover .card__img {
      mix-blend-mode: normal;
      filter: none;
      opacity: 1;
    }
  }

  /* And the open row holds that state for as long as it is open. Only one row
     is ever open, so its card being the one in colour says which one without
     adding anything to the page — and unlike the hover it survives the pointer
     moving away, and exists at all on a touch screen. */
  .row[open] .card__img {
    mix-blend-mode: normal;
    filter: none;
    opacity: 1;
  }

  /* --- Body (revealed, sitting on the page background) --- */
  .body {
    padding-block: var(--post-pad);
  }

  /* Same column as the prose, so the buttons line up with the article text. */
  .body__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 40px auto 0;
    max-width: var(--measure);
    width: 100%;
  }

  /* Animate open/close where supported. Elsewhere it simply snaps — no JS. */
  @supports (interpolate-size: allow-keywords) {
    .row::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.45s ease,
        content-visibility 0.45s allow-discrete;
    }

    .row[open]::details-content {
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row::details-content {
      transition: none;
    }
  }
</style>
