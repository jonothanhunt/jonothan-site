---
import { Picture } from "astro:assets";
import { render } from "astro:content";
import Prose from "./Prose.astro";
import YouTube from "./mdx/YouTube.astro";
import TikTok from "./mdx/TikTok.astro";
import Video from "./mdx/Video.astro";
import CodeDemo from "./mdx/CodeDemo.astro";
import { formatDate, tagSlug, tagLabel, type Post } from "../lib/posts";
import { paletteFor, type Palette } from "../lib/palette";

interface Props {
  post: Post;
  colour: Palette;
  open?: boolean;
  loading?: "lazy" | "eager";
}
const { post, colour, open = false, loading = "lazy" } = Astro.props;
const { title, date, excerpt, type, image, links } = post.data;

// Slugged tags drive the CSS-only filter in PostGrid.
const tagTokens = type.map(tagSlug).join(" ");

// The whole post is rendered here, at build time. Opening a row reveals HTML
// that is already on the page — no request, no import, no loading state.
const { Content } = await render(post);

// The ink comes from the post's own image where it has one, so the list reads
// as a set of printed plates rather than a rotation through a fixed palette.
const ink: Palette = image ? await paletteFor(image) : colour;
---

<details class="row" open={open} id={post.id} data-tags={tagTokens}>
  <summary class:list={["card", `block block--${ink}`, "marks"]}>
    <div class="card__head">
      <p class="eyebrow">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {type.length > 0 ? ` · ${type.map(tagLabel).join(" · ")}` : ""}
      </p>
      <span class="dotgrid" aria-hidden="true"></span>
    </div>

    <h2>{title}</h2>

    {
      image && (
        <div class="card__media">
          <Picture
            class="card__img duo"
            pictureAttributes={{ class: "card__pic" }}
            src={image}
            alt=""
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[560, 900, 1200, 1800]}
            sizes="(max-width: 940px) calc(100vw - 32px), 888px"
            loading={loading}
            decoding="async"
          />
        </div>
      )
    }

    <p class="card__foot spec">
      <span class="card__cue" aria-hidden="true"></span>
      <span>Read</span>
      <span class="spec__rule" aria-hidden="true"></span>
      <span class="spec__val">/blog/{post.id}</span>
    </p>
  </summary>

  <!-- Sits below the card, directly on the page background — no panel. -->
  <article class="body">
    <Prose>
      <Content components={{ YouTube, TikTok, Video, CodeDemo }} />
    </Prose>

    <footer class="body__foot">
      {
        links.map((l) => (
          <a
            class="pill pill--blog out"
            href={l.url}
            rel="noopener noreferrer"
            target="_blank"
          >
            {/* Frontmatter writes these as "SITE"; tagLabel sentence-cases
                all-caps while leaving brands like GitHub alone. */}
            {tagLabel(l.title)}
          </a>
        ))
      }
      <button
        class="pill pill--blog"
        type="button"
        data-share={`/blog/${post.id}`}
        data-title={title}
      >
        Share
      </button>
    </footer>
  </article>
</details>

<style>
  .row {
    scroll-margin-top: var(--nav-space);
  }

  /* --- Card (always visible) --- */
  /* Same anatomy as Card.astro: a label row, the title, the photo in a panel
     of its own, a spec row along the bottom. The one difference is that this
     one is a summary — it opens the post rather than going anywhere. */
  .card {
    position: relative;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 240px;
    padding: 20px;
    list-style: none;
    transition: translate 0.15s linear;
  }

  .card.block--paper {
    box-shadow: inset 0 0 0 1px var(--rule-mid);
  }

  .card::-webkit-details-marker {
    display: none;
  }

  .card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .card h2 {
    font-size: var(--t-card-row);
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  .card__media {
    position: relative;
    flex: 1;
    min-height: 120px;
    overflow: hidden;
    background: transparent;
  }

  /* See Card.astro — the <picture> wrapper must not become a flex item. */
  .card__pic {
    display: contents;
  }

  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .card__foot {
    border-top: 1px solid currentColor;
    padding-top: 10px;
  }

  .card__foot .spec__rule {
    border-top-color: transparent;
  }

  /* Disclosure cue: + closed, − open. A glyph rather than a rotating chevron,
     and specifically these two — both are one character wide in a monospaced
     face, so the row's label never changes width when it opens. The minus is
     U+2212 rather than a hyphen so it sits at the same optical weight and
     height as the plus. */
  .card__cue::before {
    content: "+";
    font-weight: 700;
  }

  .row[open] .card__cue::before {
    content: "\2212";
  }

  @media (hover: hover) {
    .card:hover {
      translate: 0 -3px;
    }
  }

  /* --- Body (revealed, sitting on the page background) --- */
  .body {
    padding-block: var(--post-pad);
  }

  /* Same column as the prose, so the buttons line up with the article text. */
  .body__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 40px auto 0;
    max-width: var(--measure);
    width: 100%;
  }

  /* Animate open/close where supported. Elsewhere it simply snaps — no JS. */
  @supports (interpolate-size: allow-keywords) {
    .row::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.45s ease,
        content-visibility 0.45s allow-discrete;
    }

    .row[open]::details-content {
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row::details-content,
    .card {
      transition: none;
    }
  }
</style>
