---
import type { ImageMetadata } from "astro";

/**
 * A logo as an iridescent sticker.
 *
 * The artwork is never drawn. It's used as a mask, and a holographic gradient
 * is painted through its silhouette — so any mark with an alpha channel
 * becomes foil without a second asset being drawn for it.
 *
 * The outline is the reason for the nested spans. CSS applies `filter` before
 * `mask`, so a `drop-shadow` on the masked element is clipped away by the very
 * mask that gives it a shape. Splitting them — filter on the outer span, mask
 * on the inner — lets the shadow ring form outside the silhouette, which is
 * where an outline goes.
 *
 * `src` may be an imported asset or a URL string, so a mask baked by
 * scripts/dither.mjs (for a logo that arrived without an alpha channel) drops
 * straight in.
 */
interface Props {
  src: ImageMetadata | string;
  /** Describes the thing, for anyone who can't see it. Empty if decorative. */
  alt?: string;
  height?: number;
  /** Overrides the width the artwork's own ratio would give it. */
  width?: number;
  /** Degrees of tilt. Stickers are applied by hand, not typeset. */
  tilt?: number;
  class?: string;
}

const {
  src,
  alt = "",
  height = 40,
  width: widthProp,
  tilt = 0,
  class: klass,
} = Astro.props;

const url = typeof src === "string" ? src : src.src;

// A mask has no intrinsic size, so the box has to be given one. Width comes
// from the artwork's own ratio where that's known; a plain URL gets a square,
// which is what every cutout the build produces is.
const ratio =
  typeof src === "string" ? 1 : (src.width ?? 1) / (src.height ?? 1);
const width = widthProp ?? Math.round(height * ratio);
---

<span
  class:list={["sticker", klass]}
  style={`--sticker-src:url("${url}");--sticker-w:${width}px;--sticker-h:${height}px;${tilt ? `--sticker-tilt:${tilt}deg;` : ""}`}
  role={alt ? "img" : undefined}
  aria-label={alt || undefined}
  aria-hidden={alt ? undefined : "true"}
>
  <span class="sticker__cut">
    <span class="sticker__foil"></span>
  </span>
</span>

<style>
  .sticker {
    display: inline-block;
    width: var(--sticker-w);
    height: var(--sticker-h);
    flex: none;
    rotate: var(--sticker-tilt, 0deg);
  }

  /* The silhouette. */
  .sticker__cut {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    -webkit-mask-image: var(--sticker-src);
    mask-image: var(--sticker-src);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  /* Four chained drop-shadows at zero blur. Each one takes the result of the
     last, so the offsets compound into a solid ring rather than four separate
     shadows — a hard outline off the artwork's own alpha, at any size, with no
     second asset.

     It is, though, a filter chain per sticker, which is why the client strip
     doesn't use this component: sixty-odd marks each carrying four chained
     drop-shadows is a lot of work for a row that scrolls. That strip gets a
     single `brightness(0)` instead, which flattens a mark to ink without
     needing a mask or a nested box at all. */
  .sticker {
    filter:
      drop-shadow(1.5px 0 0 var(--ink)) drop-shadow(-1.5px 0 0 var(--ink))
      drop-shadow(0 1.5px 0 var(--ink)) drop-shadow(0 -1.5px 0 var(--ink));
  }

  /* The ring is drawn outside the artwork, so the box has to leave it room or
     the filter's bounds clip it flat along whichever edge the mark reaches.
     `box-sizing: border-box` is global, so this takes the 2px out of the art
     rather than adding it to the box — which is what's wanted: the outline
     occupies the space, and the sticker still measures what it says it does. */
  .sticker {
    padding: 2px;
  }

  /* Oversized and centred so that rotating it never brings an edge into the
     silhouette. Two layers: the holographic sweep, and a specular highlight
     across the top-left that stops it reading as flat rainbow. */
  .sticker__foil {
    position: relative;
    display: block;
    width: 260%;
    height: 260%;
    margin: -80% 0 0 -80%;
    background-image:
      linear-gradient(
        118deg,
        rgb(255 255 255 / 0.75) 0%,
        rgb(255 255 255 / 0.1) 20%,
        rgb(255 255 255 / 0) 38%
      ),
      conic-gradient(
        from 200deg at 42% 34%,
        #5ce6c6,
        #ff9fe0,
        #9b86ff,
        #ffe873,
        #74d5ff,
        #ff9fe0,
        #5ce6c6
      );
  }

  /* The sheen only moves on hover, and it moves by rotating an element rather
     than by animating a gradient — a gradient is repainted every frame, a
     rotation is handed to the compositor and costs nothing after the first. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .sticker:hover .sticker__foil {
      animation: foil 6s linear infinite;
    }
  }

  @keyframes foil {
    to {
      transform: rotate(360deg);
    }
  }
</style>
