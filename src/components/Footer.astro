---
const year = new Date().getFullYear();

const links = [
  { label: "Email", href: "mailto:hey@jonothan.dev", out: false },
  { label: "LinkedIn", href: "https://uk.linkedin.com/in/jonothanhunt", out: true },
  { label: "GitHub", href: "https://github.com/jonothanhunt", out: true },
  { label: "RSS", href: "/rss.xml", out: false },
];
---

<footer class="site-foot">
  <div class="shell foot">
    <p class="foot__name">Jonothan Hunt <span>&#x00A9; {year}</span></p>

    <ul class="foot__links">
      {
        links.map(({ label, href, out }) => (
          <li>
            <a class:list={[out && "out"]} href={href} rel="me noopener">
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="foot__colophon">Astro &#x00B7; No trackers</p>
  </div>
</footer>

<style>
  .site-foot {
    color: var(--ink);
  }

  /* One line on desktop: name, links, colophon, with a single hairline closing
     the page off above it. It used to be three stacked spec rows, each with a
     rule of its own — three lines of type and three lines of rule for six
     words and four links, and the two rules stacked up against the section
     divider above them read as a fence. */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 24px;
    border-top: 1px solid var(--rule-mid);
    padding-top: 14px;
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .foot__name {
    margin: 0;
  }

  .foot__name span {
    color: var(--ink-soft);
  }

  /* Pushed hard right of the links, and dropped below them before there is
     room for all three on one line. */
  .foot__colophon {
    margin: 0 0 0 auto;
    color: var(--ink-soft);
  }

  .foot__links {
    display: flex;
    flex-wrap: wrap;
    /* The separator is the gap plus a hairline, drawn per item below — a gap
       alone reads as a list, the rules read as a set of fields. */
    gap: 0 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .foot__links li + li {
    border-left: 1px solid var(--rule-mid);
    padding-left: 18px;
  }

  .foot__links a {
    text-decoration: none;
  }

  .foot__links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
</style>
