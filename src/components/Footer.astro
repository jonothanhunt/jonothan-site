---
const year = new Date().getFullYear();

const links = [
  { label: "Email", href: "mailto:hey@jonothan.dev", out: false },
  { label: "LinkedIn", href: "https://uk.linkedin.com/in/jonothanhunt", out: true },
  { label: "GitHub", href: "https://github.com/jonothanhunt", out: true },
  { label: "RSS", href: "/rss.xml", out: false },
];
---

<footer class="site-foot">
  <div class="shell">
    <!-- A colophon rather than a row of links: label, rule, value, the way
         every other factual row on the site is set. -->
    <p class="spec foot__row">
      <span>Jonothan Hunt</span>
      <span class="spec__rule" aria-hidden="true"></span>
      <span class="spec__val">Creative technologist &#x2014; London</span>
    </p>

    <ul class="foot__links">
      {
        links.map(({ label, href, out }) => (
          <li>
            <a class:list={[out && "out"]} href={href} rel="me noopener">
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="spec foot__row foot__row--last">
      <span>&#x00A9; {year}</span>
      <span class="spec__rule" aria-hidden="true"></span>
      <span class="spec__val">Astro &#x00B7; No trackers &#x00B7; jonothan.dev</span>
    </p>
  </div>
</footer>

<style>
  .site-foot {
    color: var(--ink);
  }

  .site-foot .shell {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .foot__row {
    /* Hairline over the first row, so the footer is closed off from the page
       above it without a panel. */
    border-top: 1px solid var(--rule-mid);
    padding-top: 12px;
  }

  .foot__row--last {
    border-top-color: var(--rule);
    color: var(--ink-soft);
  }

  .foot__links {
    display: flex;
    flex-wrap: wrap;
    /* The separator is the gap plus a hairline, drawn per item below — a
         gap alone reads as a list, the rules read as a set of fields. */
    gap: 0 18px;
    list-style: none;
    padding: 0;
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .foot__links li + li {
    border-left: 1px solid var(--rule-mid);
    padding-left: 18px;
  }

  .foot__links a {
    text-decoration: none;
  }

  .foot__links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
</style>
