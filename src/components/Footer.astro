---
const year = new Date().getFullYear();

const links = [
  { label: "Email", href: "mailto:hey@jonothan.dev", out: false },
  { label: "LinkedIn", href: "https://uk.linkedin.com/in/jonothanhunt", out: true },
  { label: "GitHub", href: "https://github.com/jonothanhunt", out: true },
  { label: "RSS", href: "/rss.xml", out: false },
];
---

<footer class="site-foot">
  <div class="shell foot">
    <p class="foot__name">Jonothan Hunt <span>&#x00A9; {year}</span></p>

    <ul class="foot__links">
      {
        links.map(({ label, href, out }) => (
          <li>
            <a class:list={[out && "out"]} href={href} rel="me noopener">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-foot {
    color: var(--ink);
  }

  /* One line: the byline hard left, the links hard right, and nothing drawn
     between them or above them. It was three stacked spec rows with a rule
     each; then one row with a rule over it and a colophon on the end. Both
     were more structure than six words and four links need — the page has
     already ended by the time you get here, and a line saying so is a line
     saying so twice. */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 24px;
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .foot__name {
    margin: 0;
  }

  .foot__name span {
    color: var(--ink-soft);
  }

  /* `auto` rather than relying on space-between alone, so the links stay hard
     right on the wrapped layout too — where they are the only thing on their
     row and space-between has nothing to push them against. */
  .foot__links {
    display: flex;
    flex-wrap: wrap;
    margin-left: auto;
    /* The separator is the gap plus a hairline, drawn per item below — a gap
       alone reads as a list, the rules read as a set of fields. */
    gap: 0 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .foot__links li + li {
    border-left: 1px solid var(--rule-mid);
    padding-left: 18px;
  }

  .foot__links a {
    text-decoration: none;
  }

  .foot__links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
</style>
