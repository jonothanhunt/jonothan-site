---
/**
 * TikTok, as a real embed.
 *
 * Same reasoning as the YouTube one, and the same player URL the site itself
 * uses — TikTok's /player/v1/ endpoint is a plain iframe with no script tag
 * behind it, unlike the blockquote embed TikTok's own share dialog hands out,
 * which needs JavaScript every reader strips.
 *
 * No autoplay in the `allow` list: on the site the iframe is lazy and below
 * the fold, in a feed it may be the first thing on screen.
 *
 * A portrait aspect ratio, so it doesn't arrive as a letterboxed strip.
 */
interface Props {
  url: string;
}
const { url } = Astro.props;
const id = url.match(/\/video\/(\d+)/)?.[1] ?? "";
---

{
  /*
   * The remark plugin turns any tiktok.com URL on its own line into this
   * component, but only a /video/<id> one can be embedded — a profile link
   * would leave no id. Fall back to a plain link rather than rendering
   * nothing: silently dropping a paragraph of someone's article is the one
   * outcome worse than not embedding it.
   */
  !id ? (
    <p>
      <a href={url}>▶ Watch this on TikTok</a>
    </p>
  ) : (
    <figure>
      <iframe
        src={`https://www.tiktok.com/player/v1/${id}?music_info=1&description=1`}
        title="TikTok video"
        width="325"
        height="575"
        style="width:100%;max-width:325px;aspect-ratio:325/575;height:auto;border:0"
        allow="encrypted-media; picture-in-picture; fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      />
      <figcaption>
        <a href={url}>▶ Watch on TikTok</a>
      </figcaption>
    </figure>
  )
}
