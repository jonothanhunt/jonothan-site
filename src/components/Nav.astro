---
import CopyEmail from "./CopyEmail.astro";

const isBlog = Astro.url.pathname.startsWith("/blog");
const isHome = Astro.url.pathname === "/";
---

<header class="site-head" data-head data-slide={isBlog ? "" : undefined}>
  <nav
    class:list={{ "at-top": isHome }}
    aria-label="Main"
    data-nav
    data-home={isHome ? "" : undefined}
  >
    <!-- Collapsed while the hero is on screen (the big "HEY, I'M JONOTHAN"
         already says it), sliding in once you scroll past. -->
    <a class="brand" href="/" data-brand>
      <span>Jonothan</span>
    </a>

    <a class="nav-pill" href="/#work" data-link="work">Work</a>

    <a
      class:list={["nav-pill", isBlog && "on"]}
      href="/blog"
      data-link="blog"
      aria-current={isBlog ? "page" : undefined}>Blog</a
    >

    <!-- Contact opens a panel in place. No page, no JS for the disclosure. -->
    <details class="contact">
      <summary class="nav-pill">Contact</summary>
      <div class="contact__panel">
        <CopyEmail />
      </div>
    </details>

    {
      /* Blog only. The home page is built on a paper ground — the dithered
         hero, the ink client strip, the desk — and none of it has a dark
         counterpart, so offering the switch there would be offering something
         that doesn't exist. Rendered only where it works rather than hidden
         with CSS, so there is no dead control in the accessibility tree.

         No JS, no theme: the button does nothing without script, so it is
         hidden until the script that makes it work has run. */
      isBlog && (
        <button
          class="nav-pill nav-theme"
          type="button"
          data-theme-toggle
          hidden
          aria-pressed="false"
        >
          <span class="sr-only">Dark mode</span>
          <svg
            class="i-sun"
            viewBox="0 0 16 16"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="8" cy="8" r="3.2" />
            <path d="M8 .8v2.2M8 13v2.2M.8 8h2.2M13 8h2.2M2.9 2.9l1.6 1.6M11.5 11.5l1.6 1.6M13.1 2.9l-1.6 1.6M4.5 11.5l-1.6 1.6" />
          </svg>
          <svg
            class="i-moon"
            viewBox="0 0 16 16"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M13.5 10.2A5.8 5.8 0 0 1 5.8 2.5a5.8 5.8 0 1 0 7.7 7.7Z" />
          </svg>
        </button>
      )
    }
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");

  /* --- The bar scrolls with the page, on the blog ------------------------
     Not a reveal animation. The offset is driven straight off the scroll
     delta and clamped to the bar's own height, so going down the page pushes
     the bar out at exactly the rate the page moves and coming back up pulls it
     in at the same rate — it reads as a thing attached to the document rather
     than a thing that hides and shows itself. There is no transition on
     purpose: a transition would put the bar on its own clock and it would
     arrive after your finger had stopped.

     Blog only. The home page's bar floats over a hero it is meant to sit on,
     and there is nothing above the fold for it to get out of the way of.

     `transform` and nothing else, on an element that is already its own layer,
     so a scroll frame costs a composite and never a layout. */
  const head = document.querySelector<HTMLElement>("[data-head][data-slide]");

  if (head) {
    let last = Math.max(0, window.scrollY);
    let offset = 0;
    let queued = false;

    const apply = () => {
      queued = false;
      const y = Math.max(0, window.scrollY);
      const delta = y - last;
      last = y;
      // Clamped between fully out and fully in. At the very top it is always
      // in, so overscroll can't leave it parked half way.
      offset = y <= 0 ? 0 : Math.min(0, Math.max(-head.offsetHeight, offset - delta));
      head.style.transform = `translate3d(0, ${offset}px, 0)`;
    };

    addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(apply);
      },
      { passive: true },
    );
  }

  /* --- Theme -------------------------------------------------------------
     The blog can be read dark. The choice is the reader's and it is
     remembered; the OS preference is deliberately *not* consulted, because
     this is a switch on one section of an otherwise light site rather than a
     site-wide appearance setting — landing on the blog in dark because of a
     system setting, having come from a home page that is always light, reads
     as a bug.

     The <html> attribute is set before first paint by the inline script in
     Base.astro. This half only handles the button. */
  const themeToggle =
    document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  if (themeToggle) {
    const root = document.documentElement;
    // The control works, so it can be seen.
    themeToggle.hidden = false;

    const sync = () => {
      const dark = root.dataset.theme === "dark";
      themeToggle.setAttribute("aria-pressed", String(dark));
      themeToggle.querySelector(".sr-only")!.textContent = dark
        ? "Switch to light"
        : "Switch to dark";
    };
    sync();

    themeToggle.addEventListener("click", () => {
      const dark = root.dataset.theme !== "dark";
      root.dataset.theme = dark ? "dark" : "light";
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", dark ? "#16161a" : "#e8e7e3");
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch {
        /* private mode, or storage blocked — the choice just won't persist */
      }
      sync();
    });
  }

  // Close the contact panel on outside click or Escape.
  const box = document.querySelector<HTMLDetailsElement>("details.contact");
  if (box) {
    addEventListener("click", (e) => {
      if (box.open && !box.contains(e.target as Node)) box.open = false;
    });
    addEventListener("keydown", (e) => {
      if (e.key === "Escape") box.open = false;
    });
  }

  // Home only. One observer drives both the brand reveal and the Work
  // highlight, so they happen on the same beat instead of competing for
  // attention as you scroll. IntersectionObserver rather than a scroll
  // handler, so there's no main-thread work while scrolling.
  if (nav?.dataset.home !== undefined) {
    const work = document.querySelector("#work");
    const workLink = nav.querySelector('[data-link="work"]');

    // A single latch drives the whole bar: it flips once #work reaches the
    // middle of the viewport and then stays flipped for everything below,
    // because `boundingClientRect.top < 0` keeps reading true once the section
    // has gone by overhead.
    if (work && workLink) {
      new IntersectionObserver(
        ([e]) => {
          const passed = e.isIntersecting || e.boundingClientRect.top < 0;
          workLink.classList.toggle("on", passed);
          if (passed) workLink.setAttribute("aria-current", "true");
          else workLink.removeAttribute("aria-current");
          nav.classList.toggle("at-top", !passed);
        },
        { rootMargin: "-45% 0px -45% 0px" },
      ).observe(work);
    }
  }

  // Smooth-scroll to #work only when we're already on the page. Arriving from
  // another page should land there immediately — we've changed page anyway,
  // and animating the whole document afterwards just feels slow.
  nav?.querySelector('[data-link="work"]')?.addEventListener("click", (e) => {
    if (location.pathname !== "/") return;
    const target = document.querySelector("#work");
    if (!target) return;

    e.preventDefault();
    target.scrollIntoView({ behavior: "smooth" });

    // Writing a URL that carries a fragment cancels an in-flight smooth
    // scroll, so only set the hash once the scroll has settled.
    const setHash = () => history.pushState(null, "", "/#work");
    if ("onscrollend" in window)
      addEventListener("scrollend", setHash, { once: true });
    else setTimeout(setHash, 700);
  });
</script>

<style>
  /* Flush to the top edge rather than floating a --gap below it. Inset, the
     bar read as a third object on the page — a panel hovering over the hero
     with a band of photograph above it; against the edge it reads as the
     page's own chrome. Still centred, and still only as wide as it needs to
     be. */
  .site-head {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  /* A hard-edged bar: square, panel fill, nothing round it. No frame, no
     shadow and no blur — the fill alone is enough to lift it off the page,
     and the hairline was a third edge in a row that already reads as a set of
     boxes. */
  /* The bar is not a panel with things on it — it is the things, set a pixel
     apart.
     ---
     No padding: with a --ui-pad ring around them an active pill's ink stopped
     short of every edge, so the bar read as a black chip floating on a white
     one. The pills carry that padding as height instead, so the bar measures
     what it always did and a fill reaches the edge.
     ---
     No background either, and a 1px gap between the items. The separators used
     to be hairlines drawn on a continuous panel; now the panel is actually
     broken and the page shows through the joins. On the hero that means the
     photograph, which is the point — the bar reads as cut from the page rather
     than laid over it. */
  nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 1px;
    user-select: none;
    -webkit-user-select: none;
  }

  nav > *,
  .nav-pill {
    background: var(--panel);
  }

  .brand {
    display: flex;
    align-items: center;
    height: var(--nav-pill);
    overflow: hidden;
    font-family: var(--mono);
    font-weight: 800;
    font-size: var(--t-brand);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    /* Width and opacity animate; nothing else reflows around it. */
    max-width: 9em;
    opacity: 1;
    /* Same padding as the pills beside it, less its own (much smaller)
       tracking on the right. */
    padding-inline: var(--nav-pad-x) calc(var(--nav-pad-x) - 0.02em);
    transition:
      max-width 0.5s var(--ease-settle),
      opacity 0.5s var(--ease-settle),
      padding 0.5s var(--ease-settle);
  }

  .brand span {
    white-space: nowrap;
  }

  nav.at-top .brand {
    max-width: 0;
    opacity: 0;
    padding-inline: 0;
  }

  /* Resting: a hairline box. Active: the same box filled with ink, type
     knocked out. The padding is identical in both states, so lighting one up
     never re-centres the bar — which is what the old widening pill did. */
  /* The side padding matches the top and bottom, measured from the *ink*.
     ---
     This was 14px, from working the vertical gap out of the font's metrics:
     a 44px pill around a 17px content area leaves 13.5 each way. That number
     is right and it is the wrong one to match, because the content area is not
     what you see. It runs from the font's ascender to its descender, and
     neither reaches the type — caps stop well below the ascender and, in a
     word with no descenders, nothing goes near the bottom of it. Screenshotting
     a pill and measuring the actual dark pixels gives 16.5 above the caps and
     18 below the baseline, against 14.3 at the sides. So the sides were short
     by about three pixels, which is exactly how it looked.
     ---
     The right side is short by the tracking. `letter-spacing` is added *after*
     every character including the last, so a letterspaced word carries 0.1em
     of empty space on its right edge that the padding then sits outside of.
     Taking it back off the right padding evens the two up. */
  .site-head {
    --nav-pad-x: 17px;
    /* Named, because the right-hand padding has to subtract exactly this much
       — see the note above — and the narrow layout changes it. */
    --nav-track: 0.1em;
  }

  .nav-pill {
    display: flex;
    align-items: center;
    height: var(--ui-h);
    padding-inline: var(--nav-pad-x) calc(var(--nav-pad-x) - var(--nav-track));
    font-family: var(--mono);
    font-weight: 700;
    font-size: var(--t-nav);
    letter-spacing: var(--nav-track);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }

  .nav-pill,
  .brand {
    height: var(--nav-pill);
  }

  /* Square, so it reads as an icon in a row of words rather than as a very
     short word. */
  .nav-theme {
    width: var(--nav-pill);
    padding-inline: 0;
    justify-content: center;
    border: 0;
    color: inherit;
    font: inherit;
  }

  .nav-theme svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    /* Mitred, like every other icon on the site. */
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  /* Whichever one you'd be switching *to*. */
  .nav-theme .i-moon {
    display: none;
  }

  :root[data-theme="dark"] .nav-theme .i-sun {
    display: none;
  }

  :root[data-theme="dark"] .nav-theme .i-moon {
    display: block;
  }

  .nav-pill::-webkit-details-marker {
    display: none;
  }

  .nav-pill.on,
  details[open] > .nav-pill {
    background: var(--ink);
    color: var(--paper);
  }

  @media (hover: hover) {
    .nav-pill:hover {
      background: var(--ink);
      color: var(--paper);
    }
  }

  /* --- Contact panel: square, framed, same padding as the bar itself --- */
  /* Transparent, so the 1px joins either side of it stay open. Its summary
     paints itself like every other pill. */
  .contact {
    position: relative;
    background: none;
  }

  /* Joined to the bar rather than floating under it: same fill, same padding,
     no frame, and its top edge on the bar's bottom edge. The two read as one
     shape that grew rather than as a bar and a box — which is what the
     disclosure actually is.

     The offset is measured from the summary, so the nav's own bottom padding
     is added back to reach the bar's edge, and the panel is pulled out by the
     same amount on the right so its side lines up with the bar's. */
  /* Flush under the bar and flush around its contents. Any padding here is a
     band of panel between the bar and the address, and it shows most on hover,
     where the address fills with ink and the gap around it turns into a
     visible ledge. */
  .contact__panel {
    position: absolute;
    /* One pixel clear of the bar, which is the gap the bar keeps between its
       own items. The panel is what the bar drops, so it should be spaced from
       it the way the pills are spaced from each other. */
    top: calc(100% + 1px);
    right: 0;
    /* And no ground of its own.
       ---
       It was --panel, the same colour the two halves of the copy control paint
       themselves — so the 1px gap between the address and the button was
       there, correctly, and completely invisible: panel on panel. Dropping the
       background lets the page show through both that seam and the one above,
       which is exactly what happens between the items in the bar and between
       the two halves on the teal block. One construction, three places. */
    /* No entrance. It faded up over four pixels, which is the sort of thing
       that reads as polish in isolation and as lag in use: the panel is the
       answer to a click, and two tenths of a second is long enough to see it
       arriving rather than see it there. It is also the last easing left on
       anything that opens or closes here — the pills, the filters and the
       cards all switch — so it had stopped matching the rest of the site. */
  }

  @media (prefers-reduced-motion: reduce) {
    .brand {
      transition: none;
    }
  }

  @media (max-width: 560px) {
    .brand {
      display: none;
    }

    /* Only the tracking closes up here. The padding used to drop to 9px as
       well, which was an override from before the padding was measured off the
       ink — it survived the change and quietly undid it on every phone, so the
       bar looked squeezed where the desktop one looks even. Three items and an
       icon still fit at 17px with the brand hidden. */
    .site-head {
      --nav-track: 0.06em;
    }

    .contact__panel {
      right: -8px;
    }
  }
</style>
