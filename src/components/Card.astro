---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { bottomTint } from "../lib/tint";

interface Props {
  href: string;
  eyebrow?: string;
  title: string;
  image?: ImageMetadata;
  alt?: string;
  colour?: "sun" | "flame" | "grape" | "sea" | "sky" | "rose" | "leaf" | "paper";
  /** Renders taller and with larger type — for the lead item in a grid. */
  feature?: boolean;
  sizes?: string;
  loading?: "lazy" | "eager";
}

const {
  href,
  eyebrow,
  title,
  image,
  alt = "",
  colour = "paper",
  feature = false,
  sizes = "(max-width: 700px) 100vw, 380px",
  loading = "lazy",
} = Astro.props;

const external = href.startsWith("http");

// Sampled from the image's lower band at build time, so the overlay belongs to
// the photo instead of being a flat black wash.
const t = image ? await bottomTint(image) : null;
---

<a
  class:list={["card", `block block--${colour}`, feature && "card--feature"]}
  href={href}
  style={t && `--tint:${t.tint};--on-tint:${t.ink}`}
  {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  {
    image && (
      <Image
        class="card__img"
        src={image}
        alt={alt}
        widths={feature ? [480, 780, 1100] : [340, 560, 760]}
        sizes={sizes}
        loading={loading}
        decoding="async"
      />
    )
  }
  <div class="card__text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h3>{title}</h3>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 300px;
    text-decoration: none;
    isolation: isolate;
    transition: transform 0.18s ease;
  }

  .card--feature {
    min-height: 420px;
  }

  /* Image fills the block; the text sits on a scrim above it. */
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* Overlay tinted with the image's own bottom colour, pushed light or dark
     so the text always contrasts. Sits above the image (-2), below text. */
  .card:has(.card__img)::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      var(--tint) 0%,
      var(--tint) 30%,
      transparent 88%
    );
  }

  .card__img + .card__text {
    color: var(--on-tint, #fff);
  }

  .card__text {
    position: relative;
  }

  .card__text h3 {
    margin-top: 0.25em;
  }

  .card--feature .card__text h3 {
    font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3rem);
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-4px);
    }
  }
</style>
