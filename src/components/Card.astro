---
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { paletteFor, type Palette } from "../lib/palette";
import {
  ENABLED as DITHERED,
  FORMAT as DITHER_FORMAT,
  widths as ditherWidths,
} from "../lib/dither-images.mjs";

/**
 * A card, laid out as a spec sheet rather than as a photo with a caption on
 * it.
 *
 * The old card put the title over the bottom of the image and had to sample
 * the photo to find a wash that its type would survive. This one gives the
 * photo a panel of its own and prints the type on flat colour, which means
 * the contrast is decided in the palette rather than measured per image — and
 * the photo gets to be a duotone instead of a backdrop with a scrim on it.
 */
interface Props {
  href: string;
  eyebrow?: string;
  title: string;
  image?: ImageMetadata;
  alt?: string;
  /** Left unset, an image's own mean hue picks the ink. */
  colour?: Palette;
  /** Renders taller and with larger type — for the lead item in a grid. */
  feature?: boolean;
  sizes?: string;
  loading?: "lazy" | "eager";
  /** Printed hard right of the footer rule. The destination, usually. */
  meta?: string;
}

const {
  href,
  eyebrow,
  title,
  image,
  alt = "",
  colour,
  feature = false,
  sizes = "(max-width: 767px) calc(100vw - 32px), calc(33.3vw - 21px)",
  loading = "lazy",
  meta,
} = Astro.props;

const external = href.startsWith("http");

// The ink comes from the photo unless the caller insists. One sharp pass per
// image for the whole build, cached in the module.
const ink: Palette = colour ?? (image ? await paletteFor(image) : "paper");

// The footer's value: whatever was passed, or the host it points at.
const dest = meta ?? (external ? new URL(href).hostname.replace(/^www\./, "") : href);
---

<a
  class:list={[
    "card",
    `block block--${ink}`,
    // Registration marks only on a card with nothing in its corners. Once the
    // photograph fills the card, all four corners carry a plate, and a
    // crosshair behind one is just a smudge under the type.
    !image && "marks",
    feature && "card--feature",
    !image && "card--bare",
  ]}
  href={href}
  {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  {
    /* A dithered image is a PNG and only a PNG.
       ---
       <Picture> offers the browser avif and webp and labels each <source> with
       its type. The dither has to come out of a lossless codec — a lossy one
       smears a field of hard single-pixel dots — so the service returns PNG
       whatever format was asked for, and the labels would then be lies the
       browser acts on. A single <Image> asking for png is the honest request.
       ---
       Cost, so it is not a surprise: twenty-seven colours in an indexed PNG is
       heavier than the same picture as avif. This is the trade the experiment
       is making. */
  }
  {
    image &&
      (DITHERED ? (
        <Image
          class="card__img duo is-dithered"
          src={image}
          alt={alt}
          format={DITHER_FORMAT}
          dither
          widths={ditherWidths(
            feature ? [480, 780, 1100, 1600] : [380, 560, 780, 1040],
          )}
          sizes={sizes}
          loading={loading}
          decoding="async"
        />
      ) : (
        <Picture
          class="card__img duo"
          pictureAttributes={{ class: "card__pic" }}
          src={image}
          alt={alt}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={feature ? [480, 780, 1100, 1600] : [380, 560, 780, 1040]}
          sizes={sizes}
          loading={loading}
          decoding="async"
        />
      ))
  }

  <div class="card__top">
    <p class="card__chip"><span>{eyebrow ?? "Work"}</span></p>
    <p class="card__chip card__meta"><span class="out">{dest}</span></p>
  </div>

  <h3 class="card__chip card__title plate"><span>{title}</span></h3>
</a>

<style>
  /* A block of colour with the photograph multiplied across the whole of it,
     and the three pieces of text set on chips over the top — category at the
     top left, destination at the top right, title at the bottom left.
     Previously the photo had a panel of its own in a flex column below the
     title, which made every card a header and a picture; giving the image the
     whole card makes the card the picture, and the type reads as something
     applied to it. */
  .card {
    position: relative;
    display: block;
    min-height: 320px;
    /* The chips are inset from the edge rather than held in by the card's
       padding, and the registration marks own the corners, so the box needs no
       padding of its own. */
    padding: 0;
    text-decoration: none;
  }

  /* No photograph: the title has nothing to sit over, so the card is set as a
     plain block and the chips lose their ground. */
  .card--bare {
    padding: 20px;
  }

  .card.block--paper {
    box-shadow: inset 0 0 0 1px var(--rule-mid);
  }

  /* <picture> is only a wrapper for the format sources — it must not become a
     box of its own. With display:contents it vanishes and the img positions
     against the card. */
  .card__pic {
    display: contents;
  }

  /* Held back to 60% at rest, so the block's colour carries the card and the
     photograph reads as something printed into it rather than as the card
     itself. Full strength on hover, with the blend and the duotone filter
     dropped at the same instant — the image arrives all at once rather than
     brightening into place.

     On a touch screen there is no hover, so the card stays at 60% — which is
     the same bargain the duotone already makes there, and the reason the
     titles sit on plates rather than on the picture. */
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    opacity: 0.6;
  }

  /* One chip, three positions. The ground is the card's own block colour, read
     from `--block-ground`, so the type sits on the same ink the card is
     printed in and stays legible over any part of the photograph — which is
     what the reference does with its magenta caption plates. */
  /* The plate is on the *inline* span, not on the chip.
     ---
     A title runs to two lines more often than not, and the two are rarely the
     same length. With the ground on the block, the plate is a rectangle as
     wide as the longest line, so a short second line leaves a slab of empty
     colour beside it. `box-decoration-break: clone` gives every line box its
     own copy of the background and its own padding, so each line gets a plate
     that ends where the words do — which is what the reference does, and what
     a caption plate is.
     ---
     The vertical padding is deliberately more than half the leading, so
     consecutive plates overlap rather than leaving a hairline of photograph
     between them. Same colour, so the overlap is invisible. */
  /* Hard into the corners. The plate is the padding — a gap between it and
     the card's edge would read as a second, softer frame inside the block, and
     the block already has an edge. */
  .card__chip {
    margin: 0;
  }

  /* The two top plates are one row, not two independently placed boxes.
     ---
     Absolutely positioned separately they had no relationship: on a narrow
     card a long category and a long destination simply overlapped, and there
     was nothing in the layout to stop them. In a row they push against each
     other and the flex gap holds.
     ---
     The row also owns the type. Placed separately, the category plate
     inherited the card's 16px font on its own block and only set 11px on the
     span inside it — and `line-height: 1` resolves against the *block's* font,
     not the span's, so its line box was 16px against the destination's 11 and
     the two plates came out five pixels different in height for the same size
     of text. Setting the type once, on the row, is what makes them match. */
  .card__top {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  .card__top .card__chip {
    min-width: 0;
    padding: 6px var(--plate-pad-x);
    background: var(--block-ground);
  }

  /* Inherit, so nothing inside a plate can reintroduce the mismatch above. */
  .card__top .card__chip > span {
    font: inherit;
    letter-spacing: inherit;
    line-height: 1;
  }



  /* An unphotographed card has no image to sit over, so a plate around each
     line would be a box drawn for no reason. */
  .card--bare .card__top,
  .card--bare .card__title {
    position: static;
    max-width: none;
  }

  .card--bare .card__top .card__chip,
  .card--bare .card__title > span {
    padding: 0;
    background: none;
  }

  .card--bare .card__title {
    line-height: 1.15;
  }

  .card__meta {
    text-align: right;
  }

  .card__title {
    position: absolute;
    z-index: 1;
    max-width: calc(100% - 24px);
    /* Not 0 — see "Caption plates" in global.css. The plate overhangs this
       block, so aligning the *block* to the card's edge would push the
       overhang outside it, where the card's own `overflow: hidden` cuts it
       off and the last line comes out with less padding under it than the
       first line has over it. Offsetting by the overhang puts the plate on
       the edge instead of the box. */
    bottom: var(--plate-overhang);
    left: 0;
    /* Balanced, not pretty. Now that each line carries its own plate, the
       lines' relative lengths are a visible part of the shape — two plates of
       roughly equal width read as deliberate, where a long one over a short
       one reads as a ragged edge. */
    text-wrap: balance;
  }

  .card--feature .card__title {
    font-size: var(--t-card-feature);
    letter-spacing: -0.04em;
  }

  .card--bare .card__title {
    margin-top: 12px;
  }

  /* Hovering takes the photograph out of `multiply` and lets it print in its
     own colours — the card stops being a duotone for as long as you hold it.
     Cheaper than it looks: dropping the blend mode and the filter is a
     compositor change, and the decoded image is already in hand.

     Deliberately not eased. A duotone and a full-colour photograph are two
     states, not two ends of a range, and a quarter-second crossfade between
     them reads as the image loading rather than as a switch. Nothing else
     moves: the plates keep their size, the card keeps its position.

     Pointer devices only. On a touch screen a `:hover` state lasts exactly as
     long as the tap that is already navigating away, so it would read as a
     flicker on the way out of the page rather than as a reveal. */
  @media (any-hover: hover) {
    .card:hover .card__img {
      mix-blend-mode: normal;
      filter: none;
      opacity: 1;
    }
  }
</style>
