---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { paletteFor, type Palette } from "../lib/palette";

/**
 * A card, laid out as a spec sheet rather than as a photo with a caption on
 * it.
 *
 * The old card put the title over the bottom of the image and had to sample
 * the photo to find a wash that its type would survive. This one gives the
 * photo a panel of its own and prints the type on flat colour, which means
 * the contrast is decided in the palette rather than measured per image — and
 * the photo gets to be a duotone instead of a backdrop with a scrim on it.
 */
interface Props {
  href: string;
  eyebrow?: string;
  title: string;
  image?: ImageMetadata;
  alt?: string;
  /** Left unset, an image's own mean hue picks the ink. */
  colour?: Palette;
  /** Renders taller and with larger type — for the lead item in a grid. */
  feature?: boolean;
  sizes?: string;
  loading?: "lazy" | "eager";
  /** Printed hard right of the footer rule. The destination, usually. */
  meta?: string;
}

const {
  href,
  eyebrow,
  title,
  image,
  alt = "",
  colour,
  feature = false,
  sizes = "(max-width: 767px) calc(100vw - 32px), calc(33.3vw - 21px)",
  loading = "lazy",
  meta,
} = Astro.props;

const external = href.startsWith("http");

// The ink comes from the photo unless the caller insists. One sharp pass per
// image for the whole build, cached in the module.
const ink: Palette = colour ?? (image ? await paletteFor(image) : "paper");

// The footer's value: whatever was passed, or the host it points at.
const dest = meta ?? (external ? new URL(href).hostname.replace(/^www\./, "") : href);
---

<a
  class:list={[
    "card",
    `block block--${ink}`,
    "marks",
    feature && "card--feature",
  ]}
  href={href}
  {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <div class="card__head">
    <p class="eyebrow">{eyebrow ?? "Work"}</p>
    <span class="dotgrid" aria-hidden="true"></span>
  </div>

  <h3 class="card__title">{title}</h3>

  {
    image && (
      <div class="card__media">
        <Picture
          class="card__img duo"
          pictureAttributes={{ class: "card__pic" }}
          src={image}
          alt={alt}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={feature ? [480, 780, 1100, 1600] : [380, 560, 780, 1040]}
          sizes={sizes}
          loading={loading}
          decoding="async"
        />
      </div>
    )
  }

  <p class="card__foot spec">
    <span>{external ? "Link" : "Read"}</span>
    <span class="spec__rule" aria-hidden="true"></span>
    <span class="spec__val out">{dest}</span>
  </p>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 320px;
    /* The registration marks sit at inset 8px, so the content is held a step
       further in than a plain block's --pad or it would collide with them. */
    padding: 20px;
    text-decoration: none;
    /* Colour alone separates a block from the page; a paper card needs a
       hairline to do the same job. */
    transition: translate 0.15s linear;
  }

  .card.block--paper {
    box-shadow: inset 0 0 0 1px var(--rule-mid);
  }

  .card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .card__title {
    /* Balance is for a heading that gets two or three words a line; a card
       title is short enough that balancing it strands a single word. */
    text-wrap: pretty;
  }

  .card--feature .card__title {
    font-size: var(--t-card-feature);
    letter-spacing: -0.04em;
  }

  /* The photo takes whatever height is left, so a row of cards has its images
     bottom-aligned however long the titles above them run. */
  .card__media {
    position: relative;
    flex: 1;
    min-height: 120px;
    overflow: hidden;
    /* Multiply needs something under it to tint. On a block of colour that's
       the block; the image's own box must not paint a ground of its own in
       between. */
    background: transparent;
  }

  /* <picture> is only a wrapper for the format sources — it must not become a
     box in the card's flex column, or it would take a row of its own. With
     display:contents it vanishes and the img positions against .card__media. */
  .card__pic {
    display: contents;
  }

  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .card__foot {
    /* Hairline above the footer row, full width of the padding box. */
    border-top: 1px solid currentColor;
    padding-top: 10px;
    opacity: 0.92;
  }

  .card__foot .spec__rule {
    /* The row already has a rule above it; a second one running through it
       is one line too many. */
    border-top-color: transparent;
  }

  /* Cards lift on hover. `translate` rather than `transform` so it composes
     with the sticker tilt and anything else that wants the transform. */
  @media (hover: hover) {
    .card:hover {
      translate: 0 -3px;
    }
  }
</style>
