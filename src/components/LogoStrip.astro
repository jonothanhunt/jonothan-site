---
import { Image } from "astro:assets";

// Eagerly collected at build time so each logo keeps its intrinsic size.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/logos/{adobe,beko,bt,coca_cola,duracell,ee,hsbc,microsoft,nhs,tiktok,unilever}_logo.svg",
  { eager: true },
);

const logos = Object.entries(files)
  .map(([path, mod]) => ({
    src: mod.default,
    alt: `${
      path
        .split("/")
        .pop()!
        .replace("_logo.svg", "")
        .replace(/_/g, " ")
        .replace(/\b\w/g, (c) => c.toUpperCase())
    } logo`,
  }))
  .sort((a, b) => a.alt.localeCompare(b.alt));

// The animation slides the track by half its width, so the two halves have to
// be identical — and each half has to be at least as wide as the viewport, or
// the run ends mid-screen and leaves a gap on the right. One pass of eleven
// logos is roughly 1600px, so three passes per half covers past 4K.
const PASSES_PER_HALF = 3;
const half = Array.from({ length: PASSES_PER_HALF }, () => logos).flat();
const track = [...half, ...half];
---

<div class="strip">
  <ul>
    {
      track.map(({ src, alt }, i) => (
        <li>
          <Image src={src} alt={i < logos.length ? alt : ""} height={30} loading="lazy" />
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* No panel behind it, as on the original — the logos sit straight on the
     page and the mask alone gives the row its ends. */
  .strip {
    overflow: hidden;
    padding: 22px 0;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }

  /* On a phone the strip breaks out of the page gutter and runs to both edges
     of the screen, and the mask comes off with it.
     The fade exists to disguise logos being cut in half where the strip stops
     short of the edge — with a margin beside it, a hard clip looks like a
     mistake. Once the strip ends at the edge of the glass there is nothing to
     disguise: the screen is the boundary, and logos passing off it read as a
     marquee continuing rather than as content being chopped. The moment there
     is a margin either side again, above this width, the fade comes back. */
  @media (max-width: 767px) {
    .strip {
      margin-inline: calc(-1 * var(--gap));
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  ul {
    display: flex;
    align-items: center;
    gap: 3.5rem;
    padding: 0 1.75rem;
    width: max-content;
    list-style: none;
    /* One compositor-only transform. No JS, no layout, no paint.
       The duration covers half the track, so it has to grow with the track:
       tripling the passes above at the old 46s would have tripled the speed.
       ~4260px over 210s is about 20px/s — a slow drift. */
    animation: slide 210s linear infinite;
  }

  li {
    display: flex;
    flex: none;
    align-items: center;
  }

  /* Logos vary wildly in aspect ratio — a wordmark like Duracell would
     otherwise dwarf a square mark. Cap the width at 3:1 and let object-fit
     scale the wide ones down rather than letting them stretch the row. */
  img {
    height: 30px;
    width: auto;
    max-width: 90px;
    object-fit: contain;
    opacity: 0.9;
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ul {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      gap: 2rem;
    }
  }
</style>
