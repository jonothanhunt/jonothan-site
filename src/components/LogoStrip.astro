---

/**
 * The client strip: brand marks in their own colours, rasterised small and
 * drawn back at double size so the sampling shows.
 *
 * An earlier pass flattened every mark to ink with `brightness(0)`, which
 * settled the argument between eleven brand palettes and the site's seven inks
 * by silencing one side — and cost three of the marks their meaning, because
 * NHS, EE and HSBC all carry theirs as a hole in a filled field and a flatten
 * fills the hole. Pixelating instead keeps the colour *and* the counter-change
 * and still reads as one treatment applied to all eleven, which is what the
 * flatten was for.
 *
 * The sampling and the hard alpha threshold both happen at build time — see
 * PIXELS in scripts/dither.mjs. They have to: `image-rendering: pixelated`
 * only does anything when there are fewer source pixels than the box needs,
 * and an SVG has exactly as many as it is asked for. The marks arrive here as
 * ordinary assets with their own dimensions, 15px tall, every pixel either
 * fully opaque or fully clear, and are drawn at 30 — one source pixel to a
 * hard 2×2 block.
 *
 * Deliberately a plain <img> and not <Image>. The asset is already at exactly
 * the size it wants to be, and putting it back through the image service would
 * re-encode a 1-bit alpha channel as lossy webp — which puts soft pixels back
 * around every edge, which is the entire thing this is avoiding.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/generated/*-pixel.png",
  { eager: true },
);

/* The height every mark is drawn at, in CSS pixels — what the strip was before
   any of this, and what it goes back to.
   ---
   The magnification follows from it rather than the other way round. It was a
   flat 2x for a while, which made each source pixel a clean 2x2 block and left
   room for only seventeen pixels of mark height at this size: tidy, and too
   coarse to read — BT came out as a blob. Baking at 22 and drawing at 28 is
   about 1.27x, which is not a whole number, so the blocks are no longer all
   the same size.
   ---
   That turns out not to matter, because the effect was never really the grid.
   The hard alpha baked in by scripts/dither.mjs is what makes these look
   drawn-before-antialiasing, and an uneven staircase reads as a staircase
   either way. On a 2x screen — which is where this is mostly seen — it lands
   on two and a half device pixels a side: fine enough to keep a wordmark
   legible, coarse enough to stay obviously sampled. */
const DISPLAY_H = 28;

const logos = Object.entries(files)
  .map(([path, mod]) => {
    const name = path.split("/").pop()!.replace("-pixel.png", "");
    return {
      src: mod.default,
      alt: `${name.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase())} logo`,
    };
  })
  .sort((a, b) => a.alt.localeCompare(b.alt));

// The animation slides the track by half its width, so the two halves have to
// be identical — and each half has to be at least as wide as the widest
// viewport, or the run ends mid-screen and leaves a gap on the right. Four
// passes of eleven is comfortably past 4K with room to spare.
//
// Every mark loads eagerly. They are a couple of hundred bytes each, and
// `lazy` was the other half of the gap on the right: a browser decides what to
// defer from where an element *is*, and a marquee's are all off-screen at load
// and then arrive at speed. They popped in as they reached the edge, which
// read as the loop breaking rather than as images loading.
const PASSES_PER_HALF = 4;
const half = Array.from({ length: PASSES_PER_HALF }, () => logos).flat();
const track = [...half, ...half];
---

<div class="strip">
  <ul>
    {
      track.map(({ src, alt }, i) => (
        <li>
          <img
            src={src.src}
            alt={i < logos.length ? alt : ""}
            width={Math.round((src.width * DISPLAY_H) / src.height)}
            height={DISPLAY_H}
            loading="eager"
            decoding="sync"
          />
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* No panel behind it and no rules above or below — the logos sit straight on
     the page and the mask alone gives the row its ends. The two hairlines that
     used to bracket it made a band of something that isn't one: the strip is a
     run of marks drifting past, not a table row. */
  .strip {
    overflow: hidden;
    padding: 26px 0;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }

  ul {
    display: flex;
    align-items: center;
    gap: 3.5rem;
    padding: 0 1.75rem;
    width: max-content;
    list-style: none;
    /* One compositor-only transform. No JS, no layout, no paint.
       The duration covers half the track, so it has to grow with the track:
       tripling the passes above at the old 46s would have tripled the speed.
       ~4260px over 210s is about 20px/s — a slow drift. */
    animation: slide 210s linear infinite;
  }

  li {
    display: flex;
    flex: none;
    align-items: center;
  }

  /* `pixelated` turns off the smoothing the browser would otherwise apply on
     the way up, which is the other half of the effect — the baked hard alpha
     is the first half. The width and height attributes carry the doubled size,
     so nothing here has to restate it. */
  /* Flattened to ink at rest. `brightness(0)` takes every opaque pixel to
     black and leaves the alpha alone, which is why the three counter-change
     marks still need their silhouette cut from luminance at build time —
     otherwise the knockout fills in.

     On hover the filter simply comes off and the mark prints in the colours
     baked into the file. Nothing else changes: the sampling, the hard alpha
     and the magnification are all the same, so it is the same pixel art in
     colour rather than a different image. Pointer devices only — on a touch
     screen there is no hover to speak of. */
  img {
    image-rendering: pixelated;
    filter: brightness(0);
    opacity: 0.8;
  }

  @media (hover: hover) {
    li:hover img {
      filter: none;
      opacity: 1;
    }
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ul {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      gap: 2rem;
    }
  }
</style>
