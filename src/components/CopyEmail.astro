---
const email = "hey@jonothan.dev";

interface Props {
  /** `bar` sits inside the nav's own padding; `solo` carries its own. */
  variant?: "bar" | "solo";
}
const { variant = "bar" } = Astro.props;
---

<div class:list={["copy", `copy--${variant}`]}>
  <a class="copy__link" href={`mailto:${email}`}>
    {/* Square, 1px, mitred — drawn to the same rules as the registration
        marks, so the two read as one set. Not a glyph: neither an envelope nor
        a clipboard exists in JetBrains Mono, and reaching outside the family
        for them would put a stranger's drawing next to its letterforms. */}
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M1.5 3.5h13v9h-13zM1.5 4l6.5 4.5L14.5 4"></path>
    </svg>
    {email}
  </a>
  <button
    class="copy__btn"
    type="button"
    data-copy={email}
    aria-label="Copy email address"
  >
    <svg class="i-clip" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M5.5 4.5h-4v10h8v-10h-4zM5.5 4.5v-3h9v9h-1"></path>
    </svg>
    <svg class="i-tick" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M2 8.5 6 12.5 14 3.5"></path>
    </svg>
    <span class="copy__label">Copy</span>
    {/* The visible label never changes, so the glyph swap is the only feedback
        — which a screen reader can't see. This announces it instead. */}
    <span class="sr-only" data-status aria-live="polite"></span>
  </button>
</div>

<script>
  // The only interactive script on the page. No framework, no dependencies.
  document.querySelectorAll<HTMLButtonElement>(".copy__btn").forEach((btn) => {
    const status = btn.querySelector("[data-status]");
    btn.addEventListener("click", async () => {
      // The label stays "Copy" throughout — the glyph becoming a tick is the
      // feedback, so the button never changes width mid-interaction.
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.classList.add("done");
        if (status) status.textContent = "Copied";
      } catch {
        if (status) status.textContent = "Copy failed";
      }
      setTimeout(() => {
        btn.classList.remove("done");
        if (status) status.textContent = "";
      }, 1600);
    });
  });
</script>

<style>
  .copy {
    display: inline-flex;
    align-items: stretch;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.8125rem;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Standing on its own, in the contact block, it needs the bar's padding so
     the panel reads as the same object the nav drops. No frame: in the nav it
     sits inside a panel that has none, and on the teal block the fill already
     separates it from the ground. */
  .copy--solo {
    padding: var(--ui-pad);
  }

  .copy__link,
  .copy__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    height: var(--ui-h);
    padding-inline: 11px;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  /* The address is data; the action is a control. So the action gets the caps
     and the tracking, and the address is left to read as an address. */
  .copy__label {
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* One hairline between the two halves. It only separates two resting
     halves, so it goes the moment either is hovered — by then the ink fill
     shows where one ends and the other begins, and the line cutting into it
     reads as a seam. */
  .copy__btn {
    position: relative;
    border-left: 1px solid var(--rule);
  }

  .copy:has(.copy__link:hover) .copy__btn,
  .copy:has(.copy__btn:hover) .copy__btn {
    border-left-color: transparent;
  }

  svg {
    width: 14px;
    height: 14px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    /* Mitred, not rounded. The whole point of the redesign is that no corner
       on the site is curved, and a round linejoin is a curve. */
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  /* Swap clipboard for tick on success — both boxes are the same size, so
     nothing moves. */
  .i-tick {
    display: none;
  }
  .copy__btn.done .i-clip {
    display: none;
  }
  .copy__btn.done .i-tick {
    display: block;
  }

  @media (hover: hover) {
    .copy__link:hover,
    .copy__btn:hover {
      background: var(--ink);
      color: var(--paper);
    }
  }
</style>
