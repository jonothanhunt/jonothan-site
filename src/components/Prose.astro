---
// Article body styling. Everything is plain element selectors, so MDX output
// stays clean HTML with no wrapper divs or utility classes.
//
// The one place on the site that isn't monospaced. Mono is right for every
// label, value, heading and control — and wrong for a six-thousand-word essay,
// because the varying letter widths that make a line of prose scannable are
// exactly what a monospaced face gives up. So the writing is Hyperlegible and
// everything framing it — the headings, captions, code, table headers — is
// mono, which is also how the reference sets a page of body copy.
---

<div class="prose"><slot /></div>

<style is:global>
  .prose {
    /* In rem, not ch: the footer buttons below sit at a different font-size,
       so a ch-based measure resolves to a different width and the two edges
       don't line up. */
    max-width: var(--measure);
    margin-inline: auto;
    width: 100%;
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .prose > * + * {
    margin-top: 1.1em;
  }

  /* Headings stay in the mono, uppercase and tight, so an article reads as the
     same document as the page around it. */
  .prose h2,
  .prose h3 {
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  /* No rule above a section heading. It was doing the dividing while nothing
     else on the page was, but an article already has more than enough
     hairlines around it, and a line directly over a heading reads as the
     bottom of whatever came before rather than as the top of what follows.
     The space does the same job without drawing anything. */
  .prose h2 {
    font-size: var(--t-prose-h2);
    margin-top: 2.6em;
    scroll-margin-top: 90px;
  }

  .prose h3 {
    font-size: var(--t-prose-h3);
    margin-top: 1.9em;
    scroll-margin-top: 90px;
  }

  /* Links underlined in ink-yellow, as they were before the reskin — the one
     place in an article where the palette gets to show up in the middle of
     the type rather than behind it. Two pixels rather than one: at a hairline
     a `sun` underline on paper is too pale to read as a colour at all, which
     is how it got lost. It goes to ink on hover, so the target is unambiguous
     without the underline changing weight and shifting the line. */
  .prose a {
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-color: var(--sun);
  }

  .prose a:hover {
    text-decoration-color: currentColor;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }

  .prose li + li {
    margin-top: 0.3em;
  }

  /* Square, and unframed. An article image sits on paper and keeps its own
     colour — the duotone treatment is for images printed on a block — and a
     hairline round it added a second edge to a picture that already has one. */
  .prose img {
    width: 100%;
    height: auto;
    margin-block: 1.75rem;
  }

  .prose figure {
    margin-block: 1.75rem;
  }

  .prose figure img {
    margin-block: 0;
  }

  /* Captions are data about the picture, so they're set as one: mono, small,
     letterspaced, left under the image rather than centred beneath it. */
  .prose figcaption {
    margin-top: 0.7em;
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-align: left;
  }

  /* The pull quote: one rule down the left, no fill, no italics, and the quote
     set a size up from the copy around it. The rule is the same yellow the
     links are underlined in, and heavier than a hairline for the same reason
     — it is carrying a colour, not dividing anything. */
  .prose blockquote {
    border-left: 4px solid var(--sun);
    padding: 0.1em 0 0.1em 1.2em;
    font-size: 1.15em;
    line-height: 1.5;
  }

  .prose :not(pre) > code {
    font-family: var(--mono);
    background: rgb(var(--ink-rgb) / 0.07);
    padding: 0.1em 0.35em;
    font-size: 0.86em;
  }

  .prose pre {
    font-family: var(--mono);
    padding: 1.1em 1.2em;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.6;
    /* Shiki paints its own near-white background, so the frame is what makes
       the block sit on the page rather than float above it. */
    box-shadow: inset 0 0 0 1px var(--rule-mid);
  }

  /* A dotted dither rule rather than a line — the same 4px Bayer tile the
     fades are built from, so a section break belongs to the same system. */
  .prose hr {
    border: 0;
    height: 4px;
    margin-block: 2.6em;
    background-image: var(--dot-2);
    background-size: 4px 4px;
    opacity: 0.5;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .prose th,
  .prose td {
    text-align: left;
    padding: 0.55em 0.8em;
    border-bottom: 1px solid var(--rule);
  }

  .prose th {
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom-color: var(--rule-ink);
  }
</style>
