---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import tids from "../data/atproto-tids.json";

const publicationTid = tids.__publication__;

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative URL for the social card. */
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  /** Extra JSON-LD to emit alongside the site-wide Person schema. */
  schema?: Record<string, unknown>;
  /** atproto record id for this page, if it has one. */
  atprotoTid?: string;
}

const {
  title,
  description = "Creative technologist and developer. Part of WPP Innovation",
  image = "/social-card.jpg",
  type = "website",
  publishedTime,
  schema,
  atprotoTid,
} = Astro.props;

const ATPROTO_DID =
  import.meta.env.ATPROTO_DID ?? "did:plc:3su63qgei4gylhflvwqj54lw";

const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site);
const socialImage = new URL(image, Astro.site);
const fullTitle = title === "Jonothan Hunt" ? title : `${title} — Jonothan Hunt`;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jonothan Hunt",
  alternateName: "Jonathan Hunt",
  url: "https://jonothan.dev",
  image: "https://jonothan.dev/images/jonothan_profile.jpeg",
  jobTitle: "Creative Technologist",
  worksFor: { "@type": "Organization", name: "VML" },
  sameAs: ["https://uk.linkedin.com/in/jonothanhunt"],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Fonts are render-critical, so fetch them alongside the CSS. Both
         JetBrains Mono faces are preloaded: the layout is drawn from the
         symbol face as much as it is written in the text one, so arriving
         second would mean every rule, mark and meter on the page swapping in
         late. Hyperlegible is not — it only sets article body copy, which is
         never the first thing on screen. -->
    <link
      rel="preload"
      href="/fonts/jetbrains-mono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-symbols.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Jonothan Hunt" />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={socialImage} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }

    <link
      rel="site.standard.publication"
      href={`at://${ATPROTO_DID}/site.standard.publication/${publicationTid}`}
    />
    {
      atprotoTid && (
        <link
          rel="site.standard.document"
          href={`at://${ATPROTO_DID}/site.standard.document/${atprotoTid}`}
        />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Jonothan Hunt" href="/rss.xml" />
    <meta name="theme-color" content="#e8e7e3" />

    <!--
      Theme, before the first paint.

      This has to be an inline, blocking script in the head. Anything deferred
      — a module, the nav's own script, a stylesheet media query — runs after
      the browser has already painted, and the reader sees a frame of the light
      page before it turns dark. There is no way around that ordering, which is
      why this one script is allowed to be what it is.

      Only the blog is themeable; everywhere else is explicitly light, so a
      remembered choice doesn't follow the reader onto a page built for paper.
    -->
    <script is:inline>
      (() => {
        if (!location.pathname.startsWith("/blog")) {
          document.documentElement.dataset.theme = "light";
          return;
        }
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          /* private mode, or storage blocked */
        }
        const dark = stored === "dark";
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        // The browser's own chrome, on mobile. Set here rather than left to
        // the static meta tag, or a dark page sits under a paper-coloured
        // address bar.
        if (dark) {
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", "#16161a");
        }
      })();
    </script>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(person)}
    />
    {
      schema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      )
    }
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
