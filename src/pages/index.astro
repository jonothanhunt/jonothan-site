---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import LogoStrip from "../components/LogoStrip.astro";
import CopyEmail from "../components/CopyEmail.astro";
import Desk from "../components/Desk.astro";
import Sticker from "../components/Sticker.astro";
import Toast from "../components/Toast.astro";
import { Image, Picture } from "astro:assets";
import {
  ENABLED as DITHERED,
  FORMAT as DITHER_FORMAT,
  widths as ditherWidths,
  HERO_SCALE,
} from "../lib/dither-images.mjs";
import { paletteRun } from "../lib/palette";
import * as hero from "../lib/hero.mjs";
import heroSource from "../assets/site/header.jpg";

import effects from "../assets/home/effects.jpeg";
import kitkat from "../assets/home/kitkat-heist.webp";
import magpie from "../assets/home/magpie_app.webp";
import waiting from "../assets/home/waiting_to_live.webp";
import vault from "../assets/home/hsbc_vault.webp";
import creativeTechStack from "../content/blog/_media/creative-tech-stack/creative-tech-stack.png";

import grandPrix from "../assets/logos/grand-prix.png";
// The White Pencil itself, and the D&AD hexagon badged onto it — the pair the
// site has always shown. The earlier pass dropped the pencil because its
// *silhouette* reads as a house, but the silhouette is no longer what gets
// drawn: the sticker foils the artwork rather than replacing it, so the mark
// is legible again and the substitution isn't needed.
import pencil from "../assets/logos/newblood_white_pencil.svg";
import dad from "../assets/logos/dad_logo.svg";
// The Drum arrived as a flat JPEG with no alpha, so its silhouette is cut from
// its own luminance at build time — see CUTOUTS in scripts/dither.mjs.
import drum from "../assets/logos/the_drum_logo.jpeg";

// TikTok view count, projected from a known sample so the number stays honest
// as it ages. Computed at build time — no ticker, no client JS.
const BASE_COUNT = 10_282_156_685;
const BASE_DATE = Date.parse("2026-04-25T00:00:00Z");
const PER_MINUTE = 1_496_355 / 1440;
const views = BASE_COUNT + ((Date.now() - BASE_DATE) / 60_000) * PER_MINUTE;
const billions = (views / 1e9).toFixed(1);

const posts = (await getCollection("blog", (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Both grids resolve their inks as a run rather than card by card, so no two
// neighbours print on the same colour. The order here has to match the reading
// order of the cards below it — that's the sequence the rule defends.
const [workInk, kitkatInk, magpieInk, stackInk, waitingInk, vaultInk] =
  await paletteRun([effects, kitkat, magpie, creativeTechStack, waiting, vault]);
const writingInks = await paletteRun(posts.map((post) => post.data.image));

// The hero's treatment lives in src/lib/hero.mjs, because scripts/dither.mjs
// has to agree with this page about it — see the note there. Untreated, the
// photograph goes through astro:assets like every other image on the site;
// treated, it comes from a bake in public/, which is why those widths have to
// be written out by hand (a file in public/ has no metadata for Astro to read).
//
// The fade and the crop are not part of the treatment and apply either way.
// They are how the photograph joins the page rather than anything done to the
// picture — without them it ends in a hard line across the top of the copy.
const heroSrcset = hero.WIDTHS.map((w) => `${hero.file(w)} ${w}w`).join(", ")

// The awards: three marks in a row and nothing else, as the site has always
// had them. The citation text and the hairline box around each one are gone —
// an award mark is recognised, not read, and three boxed spec pairs turned the
// most decorative thing in the hero into the most administrative. The name
// survives as the link's accessible label, which is where a screen reader
// wants it and where Google's snippet doesn't.
const awards = [
  {
    href: "https://www.lovethework.com/directory/individuals/jono-hunt-750043",
    src: grandPrix,
    alt: "Cannes Lions Grand Prix",
    height: 46,
    tilt: -4,
  },
  {
    href: "https://www.dandad.org/profiles/person/202333/jonothan-hunt/",
    src: pencil,
    alt: "D&AD New Blood White Pencil",
    // The hexagon, badged off the pencil's bottom-right corner.
    badge: dad,
    height: 40,
    tilt: 5,
  },
  {
    href: "https://www.thedrum.com/awards-case-study/inside-wunderman-thompsons-plan-spark-interest-workplace-mentoring-with-magpie",
    src: drum,
    alt: "The Drum Awards",
    height: 34,
    tilt: -2,
  },
];
---

<Base
  title="Jonothan Hunt"
  description="Creative technologist and developer. Part of WPP Innovation"
>
  <!-- The photo is the top of the page itself, not a card: full width,
       ordered-dithered, dissolving into the page through a dithered alpha ramp
       rather than fading through a gradient.

       It plays two different parts either side of the breakpoint. On a wide
       screen it is a *backdrop*: absolutely positioned behind everything,
       multiplied into the paper at low opacity, and cleared on the left with a
       horizontal gradient so the copy has somewhere to sit. On a narrow one
       there is no "beside" to put the copy in, so it stops being a backdrop
       and becomes a band: in the flow, at full strength, with the heading
       below it rather than over it. The dither ramp does the bottom edge in
       both cases — that is the one thing that doesn't change. -->
  <div class="page-photo" aria-hidden="true">
    {/* The saturation halo. Empty, and it never loads anything: it is a flat
        grey rectangle that steals the colour out of whatever is behind it,
        with a hole cut in the middle. See the note by .page-photo__halo. */}
    <div class="page-photo__halo" data-halo></div>
    {
      hero.TREATED ? (
        <img
          class="page-photo__img dither"
          src={hero.file(hero.WIDEST)}
          srcset={heroSrcset}
          sizes="100vw"
          width={hero.WIDEST}
          height={hero.height(hero.WIDEST)}
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      ) : DITHERED ? (
        <Image
          class="page-photo__img is-dithered"
          src={heroSource}
          alt=""
          format={DITHER_FORMAT}
          dither
          widths={ditherWidths(hero.WIDTHS, HERO_SCALE)}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <Picture
          class="page-photo__img"
          pictureAttributes={{ class: "page-photo__pic" }}
          src={heroSource}
          alt=""
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={hero.WIDTHS}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )
    }
  </div>

  <div class="shell stack">
    <section class="hero">
      <div class="hero__body">
        <!-- The space belongs inside the first span: the h1 is a flex column,
             and a flex container throws away whitespace-only text nodes
             between its items, so a space left between the spans would make
             the heading's text content read "Hey, I'mJonothan." to anything
             reading the markup rather than looking at it — screen readers,
             copy-paste, search results. At the end of a flex line it renders
             as nothing. -->
        <h1><span>Hey, I&rsquo;m{" "}</span><span>Jonothan.</span></h1>


        <!-- Two lines, not one wrapped one: the sentences say different
             things and the second is the affiliation, which wants to sit
             under the description rather than run on from it.

             The trailing space belongs inside the first span, for the same
             reason as in the h1 above — a flex container throws away
             whitespace-only text nodes between its items, so a space left
             between the spans would make this read "…developer.Part of WPP
             Innovation" to anything reading the markup rather than looking at
             it. At the end of a flex line it renders as nothing. -->
        <p class="lede lede--stacked">
          <span>Creative technologist and developer.{" "}</span><span
            >Part of <a href="https://www.wpp.com">WPP</a> Innovation</span
          >
        </p>

        <!-- The names live on the links rather than in the page. Left as
             snippetable text, Google is liable to append "Cannes Lions Grand
             Prix D&AD New Blood White Pencil The Drum Awards" to the
             description as a run of loose phrases; data-nosnippet is only
             honoured on div, span and section, hence the wrapper. -->
        <div data-nosnippet class="hero__awards">
          <ul>
            {
              awards.map(({ href, src, alt, badge, height, tilt }) => (
                <li>
                  <a
                    href={href}
                    rel="noopener noreferrer"
                    target="_blank"
                    aria-label={alt}
                    data-sticker-group
                  >
                    <Sticker src={src} height={height} tilt={tilt} />
                    {badge && (
                      <Sticker
                        class="hero__award-badge"
                        src={badge}
                        height={22}
                        tilt={-6}
                      />
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <LogoStrip />

    <!-- Work -->
    <section id="work" class="stack" aria-labelledby="work-h">
      <h2 id="work-h" class="sr-only">Work</h2>

      <!-- Three columns, with the lead card spanning two of them and both
           rows. The layout only ever has one or three columns, so this fills
           exactly: rows 1–2 are the feature plus two stacked cards, row 3 is
           the remaining three. -->
      <div class="grid grid--work">
        <Card
          href="https://vm.tiktok.com/ZNdr68mku/"
          image={effects}
          alt="TikTok effects I've built"
          colour={workInk}
          title={`Videos using my TikTok effects have reached ${billions} billion views`}
          eyebrow="Effects"
          meta="tiktok.com"
          feature
          sizes="(max-width: 767px) calc(100vw - 32px), calc(66.6vw - 32px)"
          loading="eager"
        />
        <Card
          href="https://www.vml.com/work/kitkat-heist"
          image={kitkat}
          alt="The KitKat Heist"
          colour={kitkatInk}
          eyebrow="Campaign"
          title="The KitKat Heist wins a Grand Prix at Cannes"
        />
        <Card
          href="https://www.thedrum.com/news/2022/12/05/inside-wunderman-thompsons-plan-spark-interest-workplace-mentoring-with-magpie"
          image={magpie}
          alt="The Magpie mentorship app"
          colour={magpieInk}
          eyebrow="App"
          title="Magpie mentorship app wins at The Drum awards"
          meta="thedrum.com"
        />
        <Card
          href="/blog/creative-tech-stack"
          image={creativeTechStack}
          alt="The Creative Tech Stack site"
          colour={stackInk}
          eyebrow="Site"
          title="Creative Tech Stack: a tools database & blog for creatives"
          meta="/blog"
        />
        <Card
          href="https://www.nhsbt.nhs.uk/news/more-than-half-the-children-transformed-into-dolls-as-part-of-an-award-winning-national-organ-donation-campaign-have-now-received-a-lifesaving-transplant-in-time-for-christmas/"
          image={waiting}
          alt="The doll of Ralph sitting on a bench"
          colour={waitingInk}
          eyebrow="Campaign"
          title="Waiting to Live gains 5,000+ donor registrations in 3 months"
          meta="nhsbt.nhs.uk"
        />
        <Card
          href="https://creative.salon/articles/work/hsbc-vml-everything-s-premier"
          image={vault}
          alt="The HSBC Vault installation at Waterloo station"
          colour={vaultInk}
          eyebrow="Installation"
          title="HSBC's vault installation tours the UK"
          meta="creative.salon"
        />
      </div>
    </section>

    <!-- Contact + the ASCII desk -->
    <section class="contact block block--sea marks--mail" aria-labelledby="contact-h">
      <div class="contact__body">
        <h2 id="contact-h">Let&rsquo;s chat!</h2>
        <p class="lede">
          Book me for a talk, ask for creative tech career advice, or
          let&rsquo;s explore installations for museums and galleries.
        </p>
        <CopyEmail variant="solo" />
      </div>
      <Desk />
    </section>

    <!-- Recent writing -->
    <section class="writing" aria-labelledby="writing-h">
      <p class="spec writing__head">
        <span id="writing-h">Recent blog posts</span>
        <span class="spec__rule" aria-hidden="true"></span>
      </p>
      <div class="grid">
        {
          posts.map((post, i) => (
            <Card
              href={`/blog/${post.id}`}
              image={post.data.image}
              alt=""
              colour={writingInks[i]}
              eyebrow={post.data.type[0]}
              title={post.data.title}
              meta="/blog"
            />
          ))
        }
      </div>
      <a class="pill pill--blog" href="/blog">All posts</a>
    </section>
  </div>

  <Toast />
</Base>

<style>
  /* No nav offset at the top. The nav floats over the hero, and the hero
     centres its own copy well below it. */
  .shell.stack {
    padding-block: 0 64px;
  }

  /* The lead card spans two columns and both rows. */
  @media (min-width: 768px) {
    .grid--work > :global(:first-child) {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  /* The lead card carries the longest title on the page at the largest size,
     and it spans two rows — so its own min-height has to clear both rows of
     the cards beside it, or the title eats the space its photo needs. */
  @media (min-width: 768px) {
    .grid--work > :global(:first-child) {
      min-height: calc(320px * 2 + var(--gap));
    }
  }

  /* Hero */

  /* Narrow: a band across the top, in the flow, with the copy riding up into
     the bottom of it. Full-bleed — this sits outside .shell, so it has no
     gutter to escape — and anchored right for the same reason the desktop crop
     is.

     The fade is a plain gradient mask rather than the dither ramp the rest of
     the site uses. The ramp dissolves over a fixed 192px, which is most of a
     phone-sized band and none of a desktop one, and it can only ever run
     bottom-up; a gradient can be given whatever length each layout wants and
     can be intersected with a second one, which is what the wide layout needs.
     The image is already dithered — the edge doesn't have to be as well.

     The negative margin is what lets the copy sit *over* the tail instead of
     after it, so the photograph runs on behind the heading rather than
     stopping above it. */
  .page-photo {
    position: relative;
    z-index: 0;
    /* Tall enough to run the whole height of the hero, and pulled back up by
       roughly half of that so the copy sits over its lower half rather than
       after it. The two are a pair: whatever is added to one has to come off
       the other, or the copy moves rather than the photograph getting longer.

       Both in vh, and no min- or max-height, for the same reason — a clamp on
       one and not the other would let them drift apart on a short screen and
       the overlap would stop being where it was designed to be. */
    height: 88vh;
    margin-bottom: -42vh;
    overflow: hidden;
    /* A long fade, and not a straight one.
       ---
       The top third stays at full strength, because that is the half of the
       photograph nobody is reading over. Then it drops steeply through the
       band where the heading and the lede sit — a plain linear ramp left the
       image at about half strength right where the type crosses it, and black
       serif on a busy photograph at half strength is not readable. Past that
       it tails off gently to nothing at the bottom edge, so the picture runs
       on behind the copy rather than stopping at it. */
    --fade: linear-gradient(
      to bottom,
      #000 0%,
      #000 34%,
      rgb(0 0 0 / 0.3) 52%,
      rgb(0 0 0 / 0.1) 68%,
      transparent 100%
    );
    -webkit-mask-image: var(--fade);
    mask-image: var(--fade);
  }

  /* The colour follows the pointer.
     ---
     One element, no second copy of the photograph. `saturation` takes the
     saturation of the source and the hue and luminosity of what is behind it,
     so a flat mid-grey over the picture — saturation zero — leaves it
     greyscale with everything else intact. Masking that layer with a radial
     gradient that is *transparent in the middle* punches a hole in the
     desaturation rather than painting colour into it, which is why there is
     nothing to load and nothing to keep in step.

     It stays inside the photograph because .page-photo already carries a mask
     for its bottom fade, and a mask makes a stacking context. The heading is
     a sibling of that, not a child, so it never enters the blend.

     The radius is 70% of the window's longer edge — measured off the longer
     edge so it stays a round pool on any shape of screen rather than an
     ellipse tracking the aspect ratio.

     That number is the whole effect. At 50% the pool is smaller than the part
     of the picture worth looking at and reads as a vignette; at 100% it
     reaches so far past the pointer that most of the hero is coloured at once
     and there is nothing to notice. 70% keeps the far side of the picture
     properly grey, which is what makes the near side look lit.

     The stops run the whole radius rather than crowding the middle. An earlier
     set was clear only to 14% and fully grey by 78%, which made even a wide
     circle read as a small patch inside a dead margin. Clear to 30%, gone by
     the rim. */
  .page-photo__halo {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /* Off until a hovering pointer has actually been seen. The photograph is
       in full colour until then, which is what a phone or a tablet being held
       gets — and an iPad that later meets a Pencil fades into the effect
       rather than snapping into it. */
    opacity: 0;
    transition: opacity 0.7s var(--ease-settle);
    background: #808080;
    mix-blend-mode: saturation;
    --halo-r: max(70vw, 70vh);
    --hx: 50%;
    --hy: 38%;
    --halo: radial-gradient(
      circle var(--halo-r) at var(--hx) var(--hy),
      transparent 0%,
      transparent 30%,
      rgb(0 0 0 / 0.4) 56%,
      rgb(0 0 0 / 0.8) 80%,
      #000 100%
    );
    -webkit-mask-image: var(--halo);
    mask-image: var(--halo);
  }

  .page-photo__halo[data-on] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-photo__halo {
      transition: none;
    }
  }

  /* The photo is positioned, so without this the copy that overlaps it would
     paint underneath it. */
  .shell.stack {
    position: relative;
    z-index: 1;
  }

  /* See Card.astro — <picture> is only a wrapper for the format sources and
     must not become a box of its own, or the img inside it has nothing
     full-height to fill. */
  .page-photo__pic {
    display: contents;
  }

  .page-photo__img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    /* Narrow: the crop is tall and takes a slice out of the middle of a wide
       photograph, so it has to be told which slice. I stand about three
       quarters across, and `right` put that three-quarter point off the left
       of the frame — the same anchor that is correct on a wide screen is the
       wrong one here. */
    object-position: 88% center;
  }

  @media (min-width: 768px) {
    .page-photo {
      position: absolute;
      inset: 0 0 auto;
      height: 78vh;
      min-height: 0;
      max-height: none;
      margin-bottom: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: -1;
      /* Both fades on the one element now: down the page, as on narrow, and
         across it to clear the left where the copy sits. Two mask layers
         composite with `add` by default, which would have *given back* the
         coverage each one takes away — `intersect` is what multiplies them, so
         a pixel survives only where both gradients keep it. That is the whole
         reason these used to live on separate elements.

         And full strength. It was multiplied into the paper at a third
         opacity, which is what a backdrop behind copy needs — but the copy
         only sits on the left, and the horizontal fade already clears that.
         Everywhere else it was dimming a photograph for no one. */
      --fade-x: linear-gradient(
        to right,
        transparent 0%,
        rgb(0 0 0 / 0.3) 36%,
        #000 64%
      );
      --fade-y: linear-gradient(to bottom, #000 0%, #000 46%, transparent 96%);
      -webkit-mask-image: var(--fade-x), var(--fade-y);
      mask-image: var(--fade-x), var(--fade-y);
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }

    /* How much of the width is cropped here depends entirely on the window.
       At 1440 x 900 the frame is slightly wider than the 2:1 photograph, so
       nothing is cropped horizontally at all and this value does nothing. On a
       tablet, where the frame is *taller* than it is wide, almost half the
       photograph is cropped away and this value decides which half.

       `right` was the obvious anchor and the wrong one there: pinning the
       right edge slides the window as far right as it goes, which pushes me
       leftward within it and straight into the lede. Backing off to 85% moves
       the window left, which moves me right — clear of the copy on a tablet,
       and no different from `right` on a wide screen, where there is no
       overflow for it to act on. */
    .page-photo__img {
      object-position: 85% center;
    }

  }

  /* No card, no panel — the copy sits directly on the page.
     ---
     Narrow: under the photo, so it needs no room cleared above it and no
     minimum height to centre itself within. Wide: over the photo, which is
     what the tall padding and the viewport-height floor are for. */
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 20px 56px;
  }

  @media (min-width: 768px) {
    .hero {
      min-height: calc(100vh - 250px);
      padding-block: 128px 72px;
    }
  }

  .hero__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 34rem;
    padding-inline-start: 4px;
  }

  @media (min-width: 768px) {
    .hero__body {
      padding-inline-start: 8px;
    }
  }

  /* Two lines, stacked — "Jonothan." never wraps mid-word.

     Set in Lastik, which is the face the site has always had here, and then
     drawn through a filter that samples it onto a 3px grid. The heading is the
     one place a pixel *font* would have been the obvious answer and the wrong
     one: Lastik is the site's own voice, and sampling it keeps that while
     putting it on the same grid as the dithered photograph behind it, the
     client marks below it and the desk further down. It is still live text —
     selectable, searchable, read out — with a filter over it.

     Weight 70 of Lastik's 50-100 axis, which is the original site's display
     weight; 100 is the top of the axis and reads far too heavy. */
  .hero__body h1 {
    display: flex;
    flex-direction: column;
    font-family: "Lastik", var(--display);
    font-weight: 70;
    /* Sentence case, not the caps every other heading on the site is set in.
       Lastik is a serif with a proper lowercase and the original site used it
       — set in caps it loses the ascenders and descenders that give the line
       its shape, and at this size that is most of what there is to look at.

       Drawn smooth. It was sampled onto a 2px grid through an SVG filter for a
       while, to put it on the same grid as the dithered photograph behind it
       and the sampled client marks below. That came off: the technique leans
       on feTile, feMorphology and a discrete alpha transfer, and it is not
       worth shipping something that fine-grained to one browser's rendering
       path when the rest of the page carries the idea anyway. */
    text-transform: none;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }

  .hero__body h1 span {
    white-space: nowrap;
  }

  .lede--stacked {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Narrow enough that "and developer" turns onto a second line. The sentence
     reads better broken at its own clause than run to the edge of the column,
     and it stops the lede from being nearly as wide as the heading above it —
     which had the two competing rather than stacking. */
  .hero__body .lede {
    max-width: 22rem;
    /* Balanced rather than pretty: three lines of roughly equal length under
       a two-line heading reads as a block, where `pretty` left a long first
       line over a short last one. */
    text-wrap: balance;
  }

  .hero__body .lede a {
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* Awards: three marks in a row, applied by hand. No box, no caption — the
     row is a strip of stickers on the page, which is the one place the layout
     is allowed to be loose. */
  .hero__awards {
    margin-top: 2px;
  }

  .hero__awards ul {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 22px;
    list-style: none;
    padding: 0;
  }

  /* `relative` so the badge can hang off the corner, and bottom-aligned so
     three marks of three different heights sit on one baseline. */
  .hero__awards a {
    position: relative;
    display: block;
    line-height: 0;
    text-decoration: none;
  }

  /* Keyboard focus has to be visible without a box to draw on, so it draws
     its own — offset far enough to clear the artwork. */
  .hero__awards a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 5px;
  }

  /* The hexagon, badged off the pencil's bottom-right corner — the same
     relationship the mark has always had here. */
  .hero__award-badge {
    position: absolute;
    right: -11px;
    bottom: -7px;
  }

  /* The tip belongs to the award, not to the sticker.
     ---
     D&AD is two marks — the pencil and the hexagon badged off its corner —
     and they are one award. Tipping each sticker about its own centre had
     them turning independently, like two things that happen to overlap.
     Turning the anchor instead puts both on one plane, so the badge stays
     pinned to the corner it is badged to the whole way through. Awards with a
     single mark get the same treatment and look no different for it.

     The foil sweep inside each sticker still fires per sticker — see
     Sticker.astro, which also listens for this group — because the two marks
     are separate pieces of foil and would catch the light separately.

     180px is the perspective a 46px mark was getting from its own width in
     the component. These are all about that size, so one value serves. */
  @media (any-hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero__awards a {
      transform: perspective(180px);
      transition: transform 0.5s var(--ease-settle);
    }

    .hero__awards a:hover {
      transform: perspective(180px) rotateX(15deg) rotateY(15deg);
    }
  }

  /* Contact: the desk fills the panel edge to edge; the copy sits over it. */
  .contact {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 320px;
    padding: 28px;
  }

  @media (min-width: 768px) {
    .contact {
      min-height: 360px;
      padding: 40px;
    }
  }

  .contact__body {
    position: relative;
    /* Above the desk, which multiplies underneath it. Without this the
       characters print over the copy as well as behind it. */
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    max-width: 42ch;
  }

  .contact__body :global(.copy) {
    margin-top: 16px;
  }

  .contact__body .lede {
    text-wrap: pretty;
  }

  .writing {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 40px;
  }

  /* The spec row already draws a rule between its label and the right edge.
     A border underneath it as well made two parallel lines a few pixels
     apart, which reads as a mistake rather than as a heading. */
  .writing__head {
    align-self: stretch;
    width: 100%;
    margin-bottom: 18px;
    /* The size of the card titles it sits over, so the section reads as a
       heading with a list under it rather than as a caption. The tracking eases
       off with the size change: 0.14em is there to stop small caps closing up,
       and at 18px they aren't small any more — held at the label value the row
       sprawled to twice the width of the words in it. */
    font-size: var(--t-h3);
    letter-spacing: 0.06em;
  }

  .writing .grid {
    width: 100%;
  }

  .writing .pill {
    margin-top: 32px;
  }
</style>

<script>
  /**
   * The saturation halo follows the pointer.
   *
   * All this does is write two custom properties; the mask in the stylesheet
   * does the rest. Kept off entirely on anything without a pointer, and off
   * again whenever the photograph is not on screen.
   *
   * No layout is read while the pointer moves. The photograph's position in
   * the document is measured once and re-measured only when something could
   * have moved it, and `scrollY` is a cheap read that forces nothing — so a
   * pointermove costs two property writes and some arithmetic.
   */
  const halo = document.querySelector<HTMLElement>("[data-halo]");
  const photo = halo?.parentElement;

  if (halo && photo) {
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    /* Whether a hovering pointer has been seen. Not a media query and not a
       breakpoint: `hover: hover` describes the *primary* input, which on an
       iPad is a finger even when a Pencil is in the other hand, and a width
       tells you nothing about what is pointing at the screen. The only
       reliable evidence that something can hover is that it has hovered, so
       the effect waits for a pointermove that did not come from a finger. */
    let on = false;

    let left = 0;
    let top = 0;
    const measure = () => {
      const r = photo.getBoundingClientRect();
      left = r.left + scrollX;
      top = r.top + scrollY;
    };

    /* Where the pointer last was, in the viewport. Kept so that scrolling can
       move the halo without the pointer having moved: the cursor stays put on
       screen while the photograph slides under it. */
    let clientX = 0;
    let clientY = 0;
    let seen = false;

    let target = { x: 0, y: 0 };
    let current = { x: 0, y: 0 };
    let raf = 0;
    let onScreen = true;

    const place = (x: number, y: number) => {
      halo.style.setProperty("--hx", `${Math.round(x)}px`);
      halo.style.setProperty("--hy", `${Math.round(y)}px`);
    };

    const frame = () => {
      raf = 0;
      /* A fixed fraction of the remaining distance each frame. That is what
         makes a re-entry on the far side of the window glide rather than
         jump, and it eases out on its own without a duration to tune. */
      current.x += (target.x - current.x) * 0.12;
      current.y += (target.y - current.y) * 0.12;
      place(current.x, current.y);
      if (Math.hypot(target.x - current.x, target.y - current.y) > 0.5) {
        raf = requestAnimationFrame(frame);
      }
    };

    const aim = () => {
      target = { x: clientX + scrollX - left, y: clientY + scrollY - top };
      if (!seen || still.matches) {
        // First sighting has nowhere to travel from, and a reader who has
        // asked for less movement gets none of the travel at all.
        seen = true;
        current = { ...target };
        place(current.x, current.y);
        return;
      }
      if (!raf) raf = requestAnimationFrame(frame);
    };

    const onMove = (e: PointerEvent) => {
      /* A touch is a contact, not a hover: it has no position until it lands
         and none after it lifts, so following it would drag the pool around
         under the reader's own finger. */
      if (e.pointerType === "touch") return;
      if (!onScreen) return;
      clientX = e.clientX;
      clientY = e.clientY;
      aim();
      if (!on) {
        on = true;
        // Placed before it is shown, so it fades up already under the pointer.
        halo.dataset.on = "";
      }
    };

    const onScroll = () => {
      if (!on || !onScreen || !seen) return;
      aim();
    };

    addEventListener("pointermove", onMove, { passive: true });
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", () => { measure(); }, { passive: true });

    /* Re-measure whenever the photograph actually moves or changes shape.
       ---
       The offset used to be taken once, at parse time, and anything that
       settled afterwards left it stale — a late web font reflowing the hero,
       the photograph itself arriving, the address bar collapsing. The halo
       then sat a fixed distance from the pointer instead of under it, which
       reads as the effect not working at all in whichever part of the picture
       the offset had pushed it out of. */
    new ResizeObserver(measure).observe(photo);
    addEventListener("load", measure, { once: true });
    if (document.fonts?.ready) document.fonts.ready.then(measure);

    // Nothing to compute while the photograph is off screen.
    new IntersectionObserver(
      ([e]) => {
        onScreen = e.isIntersecting;
        if (!onScreen && raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      },
      { threshold: 0 },
    ).observe(photo);

    measure();
  }
</script>
