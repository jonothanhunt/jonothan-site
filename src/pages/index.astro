---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import LogoStrip from "../components/LogoStrip.astro";
import CopyEmail from "../components/CopyEmail.astro";
import Desk from "../components/Desk.astro";
import Sticker from "../components/Sticker.astro";

import effects from "../assets/home/effects.jpeg";
import kitkat from "../assets/home/kitkat-heist.webp";
import magpie from "../assets/home/magpie_app.webp";
import waiting from "../assets/home/waiting_to_live.webp";
import vault from "../assets/home/hsbc_vault.webp";
import creativeTechStack from "../content/blog/_media/creative-tech-stack/creative-tech-stack.png";

import grandPrix from "../assets/logos/grand-prix.png";
import pencil from "../assets/logos/newblood_white_pencil.svg";

// TikTok view count, projected from a known sample so the number stays honest
// as it ages. Computed at build time — no ticker, no client JS.
const BASE_COUNT = 10_282_156_685;
const BASE_DATE = Date.parse("2026-04-25T00:00:00Z");
const PER_MINUTE = 1_496_355 / 1440;
const views = BASE_COUNT + ((Date.now() - BASE_DATE) / 60_000) * PER_MINUTE;
const billions = (views / 1e9).toFixed(1);

const posts = (await getCollection("blog", (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// The hero is the one image on the site that isn't run through astro:assets.
// It's baked to 1-bit by scripts/dither.mjs instead, at three widths, and the
// widths have to be named here because a file in public/ has no metadata for
// Astro to read. 40kB at full size, which is less than the source JPEG.
const HERO_WIDTHS = [640, 900, 1223];
const heroSrcset = HERO_WIDTHS.map((w) => `/dither/hero-${w}.png ${w}w`).join(", ");

// The awards. The Drum's mark arrived as a flat JPEG with no alpha, so its
// silhouette is cut from its own luminance at build time — see CUTOUTS in
// scripts/dither.mjs — and the foil is painted through that instead.
const awards = [
  {
    href: "https://www.lovethework.com/directory/individuals/jono-hunt-750043",
    src: grandPrix,
    alt: "Cannes Lions Grand Prix",
    label: "Cannes Lions",
    value: "Grand Prix",
    tilt: -4,
  },
  {
    href: "https://www.dandad.org/profiles/person/202333/jonothan-hunt/",
    src: pencil,
    alt: "D&AD New Blood White Pencil",
    label: "D&AD New Blood",
    value: "White Pencil",
    tilt: 5,
  },
  {
    href: "https://www.thedrum.com/awards-case-study/inside-wunderman-thompsons-plan-spark-interest-workplace-mentoring-with-magpie",
    src: "/dither/drum-cutout.png",
    alt: "The Drum award",
    label: "The Drum",
    value: "Awards",
    tilt: -2,
  },
];
---

<Base
  title="Jonothan Hunt"
  description="Creative technologist and developer. Lead Creative Innovation at VML UK. Part of WPP Innovation"
>
  <!-- The photo is the top of the page itself, not a card: full width, 1-bit,
       dissolving down into the page through a dithered alpha ramp rather than
       fading through a gradient. Desktop only — on a narrow screen it would
       sit behind the copy with nowhere to go. -->
  <div class="page-photo fade-down" aria-hidden="true">
    <img
      class="page-photo__img dither"
      src={`/dither/hero-${HERO_WIDTHS.at(-1)}.png`}
      srcset={heroSrcset}
      sizes="100vw"
      width="1223"
      height="611"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="shell stack">
    <section class="hero">
      <div class="hero__body">
        <p class="spec hero__tag">
          <span>Creative technologist</span>
          <span class="spec__rule" aria-hidden="true"></span>
          <span class="spec__val">London &#x00B7; {new Date().getFullYear()}</span>
        </p>

        <!-- The space belongs inside the first span: the h1 is a flex column,
             and a flex container throws away whitespace-only text nodes
             between its items, so a space left between the spans would make
             the heading's text content read "Hey, I'mJonothan." to anything
             reading the markup rather than looking at it — screen readers,
             copy-paste, search results. At the end of a flex line it renders
             as nothing. -->
        <h1><span>Hey, I&rsquo;m{" "}</span><span>Jonothan.</span></h1>

        <p class="lede">
          Creative technologist and developer. Lead Creative Innovation at <a
            href="https://www.vml.com/united-kingdom">VML UK</a
          >. Part of <a href="https://www.wpp.com">WPP</a> Innovation
        </p>

        <!-- The alt text on these is for anyone who can't see them, not for a
             search result. Left snippetable, Google is liable to append
             "Cannes Lions Grand Prix D&AD New Blood White Pencil The Drum
             award" to the description as a run of loose phrases. data-nosnippet
             is only honoured on div, span and section, hence the wrapper. -->
        <div data-nosnippet class="hero__awards">
          <p class="label label--soft">Awards</p>
          <ul>
            {
              awards.map(({ href, src, alt, label, value, tilt }) => (
                <li>
                  <a href={href} rel="noopener noreferrer" target="_blank">
                    <Sticker src={src} alt={alt} height={44} tilt={tilt} />
                    <span class="hero__award-text" aria-hidden="true">
                      <span class="label">{label}</span>
                      <span class="hero__award-val">{value}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <LogoStrip />

    <!-- Work -->
    <section id="work" class="stack" aria-labelledby="work-h">
      <h2 id="work-h" class="sr-only">Work</h2>

      <!-- Three columns, with the lead card spanning two of them and both
           rows. The layout only ever has one or three columns, so this fills
           exactly: rows 1–2 are the feature plus two stacked cards, row 3 is
           the remaining three. -->
      <div class="grid grid--work">
        <Card
          href="https://vm.tiktok.com/ZNdr68mku/"
          image={effects}
          alt="TikTok effects I've built"
          title={`Videos using my TikTok effects have reached ${billions} billion views`}
          eyebrow="Effects"
          meta="tiktok.com"
          feature
          sizes="(max-width: 767px) calc(100vw - 32px), calc(66.6vw - 32px)"
          loading="eager"
        />
        <Card
          href="https://www.vml.com/work/kitkat-heist"
          image={kitkat}
          alt="The KitKat Heist"
          eyebrow="Campaign"
          title="The KitKat Heist wins a Grand Prix at Cannes"
        />
        <Card
          href="https://www.thedrum.com/news/2022/12/05/inside-wunderman-thompsons-plan-spark-interest-workplace-mentoring-with-magpie"
          image={magpie}
          alt="The Magpie mentorship app"
          eyebrow="App"
          title="Magpie mentorship app wins at The Drum awards"
          meta="thedrum.com"
        />
        <Card
          href="/blog/creative-tech-stack"
          image={creativeTechStack}
          alt="The Creative Tech Stack site"
          eyebrow="Site"
          title="Creative Tech Stack: a tools database & blog for creatives"
          meta="/blog"
        />
        <Card
          href="https://www.nhsbt.nhs.uk/news/more-than-half-the-children-transformed-into-dolls-as-part-of-an-award-winning-national-organ-donation-campaign-have-now-received-a-lifesaving-transplant-in-time-for-christmas/"
          image={waiting}
          alt="The doll of Ralph sitting on a bench"
          eyebrow="Campaign"
          title="Waiting to Live gains 5,000+ donor registrations in 3 months"
          meta="nhsbt.nhs.uk"
        />
        <Card
          href="https://creative.salon/articles/work/hsbc-vml-everything-s-premier"
          image={vault}
          alt="The HSBC Vault installation at Waterloo station"
          eyebrow="Installation"
          title="HSBC's vault installation tours the UK"
          meta="creative.salon"
        />
      </div>
    </section>

    <!-- Contact + the ASCII desk -->
    <section class="contact block block--sea marks--all" aria-labelledby="contact-h">
      <div class="contact__body">
        <p class="label label--soft">Contact</p>
        <h2 id="contact-h">Let&rsquo;s chat!</h2>
        <p class="lede">
          Book me for a talk, ask for creative tech career advice, or
          let&rsquo;s explore installations for museums and galleries.
        </p>
        <CopyEmail variant="solo" />
      </div>
      <Desk />
    </section>

    <!-- Recent writing -->
    <section class="writing" aria-labelledby="writing-h">
      <p class="spec writing__head">
        <span id="writing-h">Recent writing</span>
        <span class="spec__rule" aria-hidden="true"></span>
        <span class="spec__val">{posts.length} of many</span>
      </p>
      <div class="grid">
        {
          posts.map((post) => (
            <Card
              href={`/blog/${post.id}`}
              image={post.data.image}
              alt=""
              eyebrow={post.data.type[0]}
              title={post.data.title}
              meta="/blog"
            />
          ))
        }
      </div>
      <a class="pill pill--blog" href="/blog">All posts</a>
    </section>
  </div>
</Base>

<style>
  /* No nav offset at the top. The nav floats over the hero, and the hero
     centres its own copy well below it. */
  .shell.stack {
    padding-block: 0 64px;
  }

  /* The lead card spans two columns and both rows. */
  @media (min-width: 768px) {
    .grid--work > :global(:first-child) {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  /* Hero */
  .page-photo {
    display: none;
  }

  @media (min-width: 768px) {
    .page-photo {
      display: block;
      position: absolute;
      inset: 0 0 auto;
      height: 78vh;
      overflow: hidden;
      pointer-events: none;
      z-index: -1;
      /* The image is pure black and white, so left alone it would fight the
         copy for the whole top of the page. Multiplying it into the paper
         keeps the blacks and lets the page colour take the whites, and the
         opacity settles how far forward it sits. */
      mix-blend-mode: multiply;
      opacity: 0.22;
    }

    .page-photo__img {
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
      /* Anchored right: I stand about three quarters across, so a centred
         crop eats into me as the window narrows. */
      object-position: right center;
    }
  }

  /* No card, no panel — the copy sits directly on the page over the photo. */
  .hero {
    min-height: calc(100vh - 250px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 128px 72px;
  }

  .hero__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 34rem;
    padding-inline-start: 4px;
  }

  @media (min-width: 768px) {
    .hero__body {
      padding-inline-start: 8px;
    }
  }

  .hero__tag {
    align-self: stretch;
    max-width: 26rem;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-mid);
  }

  /* Two lines, stacked — "Jonothan." never wraps mid-word. */
  .hero__body h1 {
    display: flex;
    flex-direction: column;
  }

  .hero__body h1 span {
    white-space: nowrap;
  }

  .hero__body .lede {
    max-width: 30rem;
    text-wrap: pretty;
  }

  .hero__body .lede a {
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* Awards: a sticker per award with its citation set as a spec pair beside
     it, rather than three bare images in a row. */
  .hero__awards {
    margin-top: 6px;
  }

  .hero__awards ul {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 10px 8px;
    list-style: none;
    padding: 0;
    margin-top: 10px;
  }

  .hero__awards a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px 8px 8px;
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--rule);
    transition:
      box-shadow 0.15s linear,
      background-color 0.15s linear;
  }

  @media (hover: hover) {
    .hero__awards a:hover {
      box-shadow: inset 0 0 0 1px var(--rule-ink);
      background: var(--panel);
    }
  }

  .hero__award-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .hero__award-val {
    font-size: 0.8125rem;
    letter-spacing: -0.01em;
    color: var(--ink-soft);
  }

  /* Contact: the desk fills the panel edge to edge; the copy sits over it. */
  .contact {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 320px;
    padding: 28px;
  }

  @media (min-width: 768px) {
    .contact {
      min-height: 360px;
      padding: 40px;
    }
  }

  .contact__body {
    position: relative;
    /* Above the desk, which multiplies underneath it. Without this the
       characters print over the copy as well as behind it. */
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    max-width: 42ch;
  }

  .contact__body :global(.copy) {
    margin-top: 16px;
  }

  .contact__body .lede {
    text-wrap: pretty;
  }

  .writing {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 40px;
  }

  .writing__head {
    align-self: stretch;
    width: 100%;
    margin-bottom: 18px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-mid);
  }

  .writing .grid {
    width: 100%;
  }

  .writing .pill {
    margin-top: 32px;
  }
</style>
