# build output
dist/
# generated types
.astro/
# baked from src/assets by scripts/dither.mjs on every build
public/dither/
src/assets/generated/
# slimmed from src/models by scripts/model.mjs on every build
public/models/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store
# AppleDouble sidecars. The working copy lives on an exFAT volume that can't
# store macOS metadata, so it writes a ._ file beside every real one.
._*

# leftovers from the Next.js version of this site
.next/

# jetbrains setting folder
.idea/

# machine-local Claude Code settings (the shared config is in AGENTS.md)
.claude/settings.local.json

# wrangler dev state
.wrangler/

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# vite dep cache for `astro build`, kept apart from the dev server's
node_modules/.vite-build/
