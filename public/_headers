# Read by Cloudflare from the deployed asset root — see the note in _redirects.
#
# Astro fingerprints everything it emits into /_astro, so those URLs can never
# change meaning and are safe to cache forever. The fonts are versioned by
# hand: rename the file if one is ever replaced.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Unfingerprinted media out of public/. A month, so a replacement lands in a
# reasonable time without re-fetching 290-odd images on every visit.
/images/*
  Cache-Control: public, max-age=2592000

# The desk. Note that Cloudflare serves this one uncompressed: model/gltf-binary
# is not in its default compressible list, so the .glb goes over the wire raw
# while the CSS and JS beside it arrive brotli'd. It compresses about 4.5:1, so
# that is the single largest saving left on the home page — and it can't be
# fixed from here, because Content-Encoding has to describe bytes we don't get
# to re-encode. It needs a Compression Rule in the Cloudflare dashboard.
/models/*
  Cache-Control: public, max-age=2592000

/textures/*
  Cache-Control: public, max-age=2592000

/video/*
  Cache-Control: public, max-age=2592000

# No Cache-Control here: a rule that matched everything would also apply to
# the fingerprinted assets above, and Cloudflare combines matching rules
# rather than letting the most specific one win.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
